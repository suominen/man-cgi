esac

# Fast 304 path: nginx cache revalidation echoes our own
# Last-Modified back, so an exact string match is a complete test;
# any mismatch falls through to a full response.
case "${REQUEST_METHOD:-GET}" in
GET|HEAD)
    if [ -n "${LASTMOD:-}" ] &&
    [ "${HTTP_IF_MODIFIED_SINCE:-}" = "${LASTMOD}" ]
    then
	echo 'Status: 304 Not Modified'
	echo "Last-Modified: ${LASTMOD}"
	emit_cache_headers "${CLASS}"

	# End of headers; a 304 carries no body
	echo ''
	exit 0
    fi
    ;;
esac

case "${CLASS}" in
notfound)
    echo 'Status: 404 Not Found'
    ;;
esac

echo "Content-Type: text/html; charset=$CHARSET"

if [ -n "${LASTMOD:-}" ]
then
    echo "Last-Modified: ${LASTMOD}"
fi

emit_cache_headers "${CLASS}"

case "${REQUEST_METHOD:-GET}" in
HEAD)
    # End of headers; no body for a HEAD request
    echo ''
    exit 0
    ;;
esac

