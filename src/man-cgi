case "$PATH_INFO" in
''|/)
    if [ $# -lt 2 ]
    then
	QS="$(
	    echo "${1:-${QUERY_STRING:-}}" \
	    | sed \
		-e 's/%20/+/g' \
		-e 's/%2B/+/g' \
		-e 's/%2b/+/g' \
		-e 's/=$//' \
		;
	)"
	OIFS="$IFS"
	IFS="${OIFS}+"
	set -- ${QS}
	IFS="${OIFS}"
    fi

    COMMAND="${1}"
    SECTION="${2:-ANY}"
    COLL="${3:-DEFAULT}"
    ARCH=DEFAULT

    case "${COMMAND}" in
    "")
	;;
    *)
	need_redirect=true
	;;
    esac
    ;;
*)
    OIFS="$IFS"
    IFS="${OIFS}/"
    set -- ${PATH_INFO}
    IFS="${OIFS}"
    shift

    SECTION=ANY
    COLL=DEFAULT
    ARCH=DEFAULT

    case ${#} in
    1)
	COMMAND="${1}"
	;;
    2)
	COMMAND="${2}"
	case "${1}" in
	[A-Z]*)
	    COLL="${1}"
	    ;;
	*)
	    ARCH="${1}"
	    ;;
	esac
	;;
    *)
	case "${1}" in
	[A-Z]*)
	    COLL="${1}"
	    shift
	    ;;
	esac
	while [ ${#} -gt 2 ]
	do
	    need_redirect=true
	    shift
	done
	ARCH="${1}"
	COMMAND="${2}"
	;;
    esac
    ;;
esac

#case "$PATH_INFO" in
#/apropos)
#    MANPARAM="-k"
#    echo 'X-Robots-Tag: noindex'
#    ;;
#esac

set -- $COMMAND
COMMAND="$1"
set -- $SECTION
SECTION="$1"
set -- $COLL
COLL="$1"

echo "Content-Type: text/html; charset=$CHARSET"

case "$REQUEST_METHOD" in
POST)
    read a
    OIFS="$IFS"
    IFS="${OIFS}&+"
    set -- $a
    IFS="${OIFS}"

    for i
    do
	case "$i" in
	arch=*)
	    ARCH="${i#arch=}"
	    ;;
	coll=*)
	    COLL="${i#coll=}"
	    ;;
	command=*)
	    COMMAND="$(echo "$i" | sed -e 's/command=//' -e 's,%2F,/,gi')"
	    ;;
	section=*)
	    SECTION="${i#section=}"
	    ;;
	esac
    done

    ME="$(canonical_url)"

    echo 'Status: 303 See Other'
    echo "Location: $ME"
    echo
    echo 'Goto: <a href="'"$ME"'">'"$ME"'</a>'

    exit 0
    ;;
esac

case "$SECTION" in
.*)
    ARCH="${SECTION#.}"
    SECTION=
    ;;
*.*)
    ARCH="${SECTION##*.}"
    SECTION="${SECTION%%.*}"
    ;;
esac

case "$SECTION" in
ANY)
    SECTION=
    ;;
esac

case "$COMMAND" in
*.[1-9]|*.3f|*.[39]lua)
    SECTION="${COMMAND##*.}"
    COMMAND="${COMMAND%.*}"
    ;;
esac

case "$COMMAND" in
*/*)
    ARCH="${COMMAND%/*}"
    COMMAND="${COMMAND##*/}"
    ;;
esac

case "${DEFAULT_ARCH}" in
"")
    ;;
*)
    case "${ARCH}" in
    DEFAULT|"")
	ARCH="${DEFAULT_ARCH}"
	;;
    esac
    ;;
esac

case "$ARCH" in
DEFAULT|"")
    ARCH=
    ;;
*)
    export MACHINE
    MACHINE="$ARCH"
    ;;
esac

case "${ARCH}" in
"${DEFAULT_ARCH}")
    ARCH=
    ;;
esac

case "${DEFAULT_COLLECTION}" in
"")
    ;;
*)
    case "${COLL}" in
    DEFAULT|"")
	COLL="${DEFAULT_COLLECTION}"
	;;
    esac
    ;;
esac

case "${COLL}" in
DEFAULT|"")
    COLL=
    ;;
*)
    COLL=$(echo "$COLL" | tr -c -d '[-.A-Za-z0-9]')
    if [ ! -d "${MANROOT}/${COLL}" ]
    then
	case "${COLL}" in
	*-[1-9][0-9].0)
	    NCOLL="${COLL%%-*}-current"
	    if [ -d "${MANROOT}/${NCOLL}" ]
	    then
		COLL="${NCOLL}"
		ME="$(canonical_url)"

		echo 'Status: 302 Found'
		echo "Location: $ME"
		echo
		echo 'Goto: <a href="'"$ME"'">'"$ME"'</a>'

		exit 0
	    fi
	    ;;
	*-[1-9].*|*-[1-9][0-9].*)
	    MINOR="$((${COLL##*.} + 0))"
	    case "${MINOR}" in
	    0)
		;;
	    *)
		NCOLL="${COLL%.*}.$((${MINOR} - 1))-STABLE"
		if [ -d "${MANROOT}/${NCOLL}" ]
		then
		    COLL="${NCOLL}"
		    ME="$(canonical_url)"

		    echo 'Status: 302 Found'
		    echo "Location: $ME"
		    echo
		    echo 'Goto: <a href="'"$ME"'">'"$ME"'</a>'

		    exit 0
		fi
		;;
	    esac
	    ;;
	esac
    fi
    export MANPATH
    MANPATH="${MANROOT}/${COLL}"
    export GROFF_TMAC_PATH
    GROFF_TMAC_PATH="${MANPATH}/tmac"
    CNAME="${COLL%%-*}"
    CREL="${COLL#*-}"
    ;;
esac

case "${COLL}" in
"${DEFAULT_COLLECTION}")
    COLL=
    ;;
esac

if ${need_redirect:-false}
then
    ME="$(canonical_url)"

    echo 'Status: 308 Permanent Redirect'
    echo "Location: $ME"
    echo
    echo 'Goto: <a href="'"$ME"'">'"$ME"'</a>'

    exit 0
fi

# 1 hour
EXPSECS=3600

if [ "$COMMAND" != "" ]
then
    case "$SECTION" in
    "")
	if [ "$MANPARAM" = "" ]
	then
	    LASTMODFILE=$(
		man -C "$MANROOT/man.conf" -w -- "$COMMAND" 2>/dev/null
	    )
	    notfound=$?
	fi
	;;
    *)
	LASTMODFILE=$(
	    man -C "$MANROOT/man.conf" -w -- "$SECTION" "$COMMAND" 2>/dev/null
	)
	notfound=$?
	;;
    esac

    if [ ${notfound:-0} -ne 0 ]
    then
	echo 'Status: 404 Not Found'
	# 10 minutes
	EXPSECS=600
    else
	case "${COLL}" in
	*-current|*-STABLE)
	    # 8 hours
	    EXPSECS=28800
	    ;;
	*)
	    # 16 days
	    EXPSECS=1382400
	    ;;
	esac
    fi
fi

LASTMODFILE="$(echo "$LASTMODFILE" | sed -e 1q)"

case "${LASTMODFILE}" in
*/build)
    ;;
*)
    # XXX: This breaks when # DEFAULT_COLLECTION is not set
    # and the DEFAULT collection is used for system pages.

    CANONICAL_ARCH="${LASTMODFILE##${MANROOT}/}"
    CANONICAL_ARCH="${CANONICAL_ARCH#*/}"
    CANONICAL_ARCH="${CANONICAL_ARCH#*/}"
    case "${CANONICAL_ARCH}" in
    */*/*)
	# Too many!
	CANONICAL_ARCH=NONE
	;;
    */*)
	CANONICAL_ARCH="${CANONICAL_ARCH%/*}"
	;;
    *)
	CANONICAL_ARCH=NONE
	;;
    esac

    case "${SECTION}" in
    "")
	SECTION="${LASTMODFILE##*.}"
	case "${SECTION}" in
	"")
	    ;;
	[1-9]|3f|[39]lua)
	    ME="$(canonical_url)"

	    echo 'Status: 308 Permanent Redirect'
	    echo "Location: $ME"
	    echo
	    echo 'Goto: <a href="'"$ME"'">'"$ME"'</a>'

	    exit 0
	    ;;
	*)
	    SECTION=
	    ;;
	esac
	;;
    esac
    ;;
esac

if [ -f "$LASTMODFILE" ]
then
    eval $(stat -s "$LASTMODFILE")
    LASTMOD=$(date -u -r "$st_mtime" '+%a, %d %b %Y %H:%M:%S GMT')
    if [ -n "$LASTMOD" ]
    then
	echo "Last-Modified: $LASTMOD"
    fi
fi

EXPDATE=$(($(date '+%s') + $EXPSECS))
EXPIRES=$(date -u -r "$EXPDATE" '+%a, %d %b %Y %H:%M:%S GMT')

echo "Expires: $EXPIRES"
echo "Cache-Control: public, max-age=$EXPSECS"

# End of headers
cat <<END

