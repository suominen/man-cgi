	if [ -d "${MANROOT}/${NCOLL}" ]
	then
	    COLL="${NCOLL}"
	    redirect 302
	fi

	MINOR="${COLL##*.}"
	case "${MINOR}" in
	0)
	    NCOLL="${COLL%%-*}-current"
	    if [ -d "${MANROOT}/${NCOLL}" ]
	    then
		COLL="${NCOLL}"
		redirect 302
	    fi
	    ;;
	esac
    fi
    export MANPATH
    MANPATH="${MANROOT}/${COLL}"
    export GROFF_TMAC_PATH
    GROFF_TMAC_PATH="${MANPATH}/tmac"
    CNAME="${COLL%%-*}"
    CREL="${COLL#*-}"
    ;;
esac

