	    ;;
	section=*)
	    SECTION="${i#section=}"
	    ;;
	esac
    done

    ME="$(canonical_url)"

    echo 'Status: 303 See Other'
    echo "Location: $ME"
    echo
    echo 'Goto: <a href="'"$ME"'">'"$ME"'</a>'

    exit 0
    ;;
esac

