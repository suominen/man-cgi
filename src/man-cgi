MANCGI_DATE=2020-09-24

### CONFIGURATION SECTION : change the following variables to fit your needs ###

# The HTTPD server may not pass the enviroment variables to the script.
# You should add your system path here :
export PATH
PATH=/usr/local/bin:/bin:/usr/bin

# The same for the man path here :
#export MANPATH
#MANPATH=/usr/local/man:/usr/local/X/man:/usr/share/man:/usr/local/gnu/man

# Character set ISO-8859-1
export LC_CTYPE
LC_CTYPE=en_US.ISO8859-1
CHARSET=windows-1252

# OS details
OSARCH=$(uname -m)
OSNAME=$(uname -s)
OSREL=$(uname -r)

# Man page collections
MANROOT=/p/netbsd/www/man

# Last modified is NetBSD-current build retrieval date
LASTMODFILE="$MANROOT/NetBSD-current/build"

### END OF CONFIGURATION SECTION ###############################################

canonical_url()
{
    local arch coll port section

    case "${REQUEST_SCHEME:-http}" in
    https)
	case "${SERVER_PORT:-443}" in
	443)	port=;;
	*)	port=":${SERVER_PORT}";;
	esac
	;;
    *)
	case "${SERVER_PORT:-80}" in
	80)	port=;;
	*)	port=":${SERVER_PORT}";;
	esac
	;;
    esac

    case "${COLL}" in
    DEFAULT|"${DEFAULT_COLLECTION}"|"")
	coll=
	;;
    *)
	coll="${COLL}"
	;;
    esac

    case "${ARCH}" in
    DEFAULT|"${DEFAULT_ARCH}"|"")
	arch=
	;;
    *)
	arch="${ARCH}"
	;;
    esac

    case "$SECTION" in
    ANY|"")
	section=
	;;
    *)
	section="${SECTION}"
	;;
    esac

    case "${COMMAND}" in
    "")
	echo "${REQUEST_SCHEME:-http}://${SERVER_NAME}${port}${SCRIPT_NAME}?+${section}${arch:+.$arch}+${coll}"
	;;
    *)
	# XXX: We should probably have some configurable prefix, too.
	echo "${REQUEST_SCHEME:-http}://${SERVER_NAME}${port}${coll:+/$coll}${arch:+/$arch}/${COMMAND}${section:+.$section}"
	;;
    esac
}

rel_canonical_url()
{
    # Assumptions:
    # - Also serving over https, so advertise it as canonical
    # - Only using non-standard ports for development, so
    #   they are not seen by search engines

    canonical_url \
    | sed -e "
	s/^http:/https:/
	s,:[1-9][0-9]*/,/,
	${ARCH:+s,/${ARCH}/,/${CANONICAL_ARCH:-$ARCH}/,}
	s,/NONE/,/,
    "
}

list_archs()
{
    case "${DEFAULT_ARCH}" in
    "")
	echo DEFAULT
	;;
    esac
    echo NONE
    cat "${MANROOT}/archlist"
}

list_collections()
{
    case "${DEFAULT_COLLECTION}" in
    "")
	echo DEFAULT
	;;
    esac
    cat "${MANROOT}/colllist"
}

