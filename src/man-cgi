#!/bin/sh
#
# Convert output of man to HTML
#
# (c) 1994 Panagiotis J. Christias <christia@theseas.ntua.gr>
#	http://users.softlab.ntua.gr/~christia/man-cgi.html
#
# Modifications for NetBSD:
# (c) 1997-2025 Kimmo Suominen <kimmo@suominen.com>
#	https://kimmo.suominen.com/
#
# Usage:
#
#   PATH_INFO=/[COLLECTION/][ARCH/]COMMAND[.SECTION]
#
# Examples:
#
#   /boot.8
#   /boot
#   /i386/boot.8
#   /i386/boot
#   /NetBSD-9.0/boot.8
#   /NetBSD-9.0/boot
#   /NetBSD-9.0/i386/boot.8
#   /NetBSD-9.0/i386/boot
#
# Legacy usage:
#
#   QUERY_STRING=COMMAND[+[SECTION][.ARCH][+COLLECTION]]
#
# Examples:
#
#   boot+8
#   boot
#   boot+8.i386
#   boot+.i386
#   boot+8+NetBSD-9.0
#   boot++NetBSD-9.0
#   boot+8.i386+NetBSD-9.0
#   boot+.i386+NetBSD-9.0
#
# Health check:
#
#   PATH_INFO=/.well-known/health
#   QUERY_STRING=/.well-known/health
#

# Request values are word-split unquoted (the set -- splits below)
# and would be pathname-expanded against the filesystem before the
# sanitizers see them. Nothing in this script globs.
set -f

MANCGI_DATE=2026-08-25

### CONFIGURATION SECTION : change the following variables to fit your needs ###

# The HTTPD server may not pass the enviroment variables to the script.
# You should add your system path here :
#
# Outside a gateway context (e.g. the test harness) MANCGI_PATH,
# MANCGI_MANROOT, and MANCGI_MINLASTMOD may override the fixed
# values.
case "${GATEWAY_INTERFACE:-}" in
'')
    ;;
*)
    unset MANCGI_PATH MANCGI_MANROOT MANCGI_MINLASTMOD
    ;;
esac
export PATH
PATH=${MANCGI_PATH:-/usr/local/bin:/bin:/usr/bin}

# The same for the man path here :
#export MANPATH
#MANPATH=/usr/local/man:/usr/local/X/man:/usr/share/man:/usr/local/gnu/man

# Character set ISO-8859-1
export LC_CTYPE
LC_CTYPE=en_US.ISO8859-1
CHARSET=windows-1252

# OS details
OSARCH=$(uname -m)
OSNAME=$(uname -s)
OSREL=$(uname -r)

# Man page collections
MANROOT=${MANCGI_MANROOT:-/p/netbsd/man/man}

# Last modified is NetBSD-current build retrieval date
LASTMODFILE="$MANROOT/NetBSD-current/build"

# Floor for Last-Modified on rendered output (seconds since the epoch,
# UTC): every validator is max(file mtime, MINLASTMOD).
#
# Bump to the checkin time (date +%s) whenever a script change alters
# rendered output: the sed HTMLizer, the section list, query-form
# defaults (ANY/NONE/DEFAULT), cache headers, canonical URLs, page
# chrome, error bodies. Signature and MANCGI_DATE changes do not
# qualify.
#
# 2026-08-27 04:43:31 UTC
MINLASTMOD=${MANCGI_MINLASTMOD:-1787805811}

### END OF CONFIGURATION SECTION ###############################################

healthcheck()
{
    local code text

    test -d "${MANROOT}" &&
    test -f "${LASTMODFILE}" &&
    { code=200; text=OK; } ||
    { code=503; text='Service Unavailable'; }

    echo "Status: ${code} ${text}"
    echo "X-Powered-By: man-cgi (${MANCGI_DATE})"
    echo 'Content-Type: text/plain'

    emit_cache_headers health

    # End of headers
    echo ''
    echo "${text}"

    exit 0
}

canonical_url()
{
    local arch coll port section

    case "${REQUEST_SCHEME:-http}" in
    https)
	case "${SERVER_PORT:-443}" in
	443)	port=;;
	*)	port=":${SERVER_PORT}";;
	esac
	;;
    *)
	case "${SERVER_PORT:-80}" in
	80)	port=;;
	*)	port=":${SERVER_PORT}";;
	esac
	;;
    esac

    case "${COLL}" in
    DEFAULT|"${DEFAULT_COLLECTION}"|"")
	coll=
	;;
    *)
	coll="${COLL}"
	;;
    esac

    case "${ARCH}" in
    DEFAULT|"${DEFAULT_ARCH}"|"")
	arch=
	;;
    *)
	arch="${ARCH}"
	;;
    esac

    case "$SECTION" in
    ANY|"")
	section=
	;;
    *)
	section="${SECTION}"
	;;
    esac

    case "${COMMAND}" in
    "")
	# The index of a collection (ADR-0017): it carries no arch and
	# no section, and the default collection's index is /.
	echo "${REQUEST_SCHEME:-http}://${SERVER_NAME}${port}${coll:+/$coll}/"
	;;
    *)
	# XXX: We should probably have some configurable prefix, too.
	echo "${REQUEST_SCHEME:-http}://${SERVER_NAME}${port}${coll:+/$coll}${arch:+/$arch}/${COMMAND}${section:+.$section}"
	;;
    esac
}

# COLL reaches Location and canonical URLs, Surrogate-Key tokens, HTML
# attributes and MANPATH, so it is filtered once here, before any of
# them.
#
# Dropped whole rather than repaired, as sanitize_arch does: the part
# that passes the filter would name a collection the client never
# asked for, and since ADR-0017 that is enough to serve its index.
# What passes still has to look like a collection name, which is
# what refuses '.' and '..': real directories, so they satisfy the
# -d probe below and would point MANPATH at MANROOT and its parent.
# A rejected value becomes DEFAULT, so the 404 is keyed under the
# default collection and the junk never becomes a key of its own.
#
# The PATH_INFO parser already takes a leading component as the
# collection only when it starts with an uppercase letter; this applies
# the same rule to the query-string and POST forms.
sanitize_coll()
{
    local clean

    case "${COLL}" in
    DEFAULT|'')
	return
	;;
    esac

    clean=$(printf '%s' "${COLL}" | tr -cd 'A-Za-z0-9.-')

    if [ "${clean}" != "${COLL}" ]
    then
	BADCOLL=true
    fi

    case "${COLL}" in
    [A-Z]*)
	;;
    *)
	BADCOLL=true
	;;
    esac

    if ${BADCOLL:-false}
    then
	COLL=DEFAULT
    fi
}

# True when the name is in ${MANROOT}/archlist. False when the list
# is unreadable; sanitize_arch falls back to a shape rule then, and
# the path parser treats the name as a page name.
in_archlist()
{
    case "${1}" in
    '')
	return 1
	;;
    esac

    [ -r "${MANROOT}/archlist" ] &&
    grep -q -x -F -e "${1}" "${MANROOT}/archlist"
}

# ARCH reaches the same places and reached them unfiltered. Unlike
# a collection it has no single filesystem test: an architecture is
# a directory under some manN/catN, so asking the tree means a glob
# per section -- and the tree answers the wrong question anyway.
# Those directories hold only the pages that differ by
# architecture; ls(1) exists on a port whether or not the port has
# a directory here, so a collection shipping no pc532-specific page
# does not make /pc532/ls.1 meaningless.
#
# archlist is the right list. $MANROOT/Makefile builds it by
# finding those directories across every collection at once, so it
# names every architecture that has ever existed rather than the
# ones one collection ships, and it is exactly what list_archs()
# offers the query form. Validating against it means the names the
# form can produce and the names a URL will accept are one set.
#
# Unreadable, fall back to the shape rule rather than answer 404
# for every architecture on the site. Note this makes archlist
# load-bearing for serving and not just for the form: an arch that
# a rebuild adds is unusable in a URL until make(1) runs here.
#
# Dropped whole rather than repaired: keeping the part that passes
# the filter would invent a name the client never asked for. The
# value becomes DEFAULT so that it degrades correctly whether or
# not DEFAULT_ARCH is set, and BADARCH makes the request a 404 --
# an architecture that is not one names nothing, the same as a
# collection that is not one.
sanitize_arch()
{
    local clean

    case "${ARCH}" in
    DEFAULT|NONE|'')
	return
	;;
    esac

    clean=$(printf '%s' "${ARCH}" | tr -cd '.A-Za-z0-9_-')

    if [ "${clean}" != "${ARCH}" ]
    then
	BADARCH=true
    elif [ -r "${MANROOT}/archlist" ]
    then
	in_archlist "${ARCH}" ||
	BADARCH=true
    else
	case "${ARCH}" in
	[a-z]*)
	    ;;
	*)
	    BADARCH=true
	    ;;
	esac
    fi

    if ${BADARCH:-false}
    then
	ARCH=DEFAULT
    fi
}

# A page name reaches <title>, <h1>, the query form's value
# attribute, the menu lead, the 404 page's search links and every
# redirect body, and reached them raw. The set is what the served
# trees actually use: base and X11 names are [A-Za-z0-9_.-] plus
# + (c++, g++) and [ (the [.1 alias of test); pkgsrc adds @ (date@)
# and : (perl modules). ] pairs with [, and the POST parser already
# decodes both. / is not a name character: every entry form splits
# an arch prefix off before this runs, except the POST body, where
# the value is still [arch/]name[.section] and the 303 needs the
# separator to survive.
#
# Dropped whole rather than repaired, as sanitize_arch does: the
# part that passes the filter would be a name the client never
# asked for, and a page it did not ask for could be served under
# it. The value becomes empty so that no sink can reflect it, and
# BADCOMMAND makes the request a 404.
sanitize_command()
{
    local clean

    case "${COMMAND}" in
    '')
	return
	;;
    esac

    clean=$(printf '%s' "${COMMAND}" | tr -cd 'A-Za-z0-9_.+@:[]/-')

    if [ "${clean}" != "${COMMAND}" ]
    then
	BADCOMMAND=true
	COMMAND=
    fi
}

# Only the legacy query string and the command line can put
# arbitrary text here: the PATH_INFO parser takes a section only
# from a name suffix that matches the section patterns, and the
# POST arm filters the value to the arch set before its 303
# because the field also carries .ARCH. Runs after the
# SECTION.ARCH split and the ANY mapping, so what it sees is the
# section alone. The set, [0-9a-z], covers the section names (1-9,
# 3f, 3lua, 9lua, n, l); a well-formed section that is not one is
# left to man(1), which answers not found. Dropped whole for the
# same reason as the name: with the section gone the request
# would be a sectionless lookup, which is a 301 to a page the
# client did not ask for.
sanitize_section()
{
    local clean

    case "${SECTION}" in
    '')
	return
	;;
    esac

    clean=$(printf '%s' "${SECTION}" | tr -cd '0-9a-z')

    if [ "${clean}" != "${SECTION}" ]
    then
	BADSECTION=true
	SECTION=
    fi
}

# True when any sanitizer rejected its value: the request names
# no page, whatever the rest of it says.
rejected()
{
    ${BADCOLL:-false} || ${BADARCH:-false} ||
    ${BADCOMMAND:-false} || ${BADSECTION:-false}
}

rel_canonical_url()
{
    # Assumptions:
    # - Also serving over https, so advertise it as canonical
    # - Only using non-standard ports for development, so
    #   they are not seen by search engines

    local arch
    arch="$(echo "${ARCH}" | sed -e 's/,/\\,/g')"
    canonical_url \
    | sed -e "
	s/^http:/https:/
	s,:[1-9][0-9]*/,/,
	${ARCH:+s,/${arch}/,/${CANONICAL_ARCH:-${arch}}/,}
	s,/NONE/,/,
    "
}

list_archs()
{
    case "${DEFAULT_ARCH}" in
    "")
	echo DEFAULT
	;;
    esac
    echo NONE
    cat "${MANROOT}/archlist"
}

list_collections()
{
    case "${DEFAULT_COLLECTION}" in
    "")
	echo DEFAULT
	;;
    esac
    cat "${MANROOT}/colllist"
}

# One shared section list: the /api/v1/sectlist endpoint, the query
# form, and the intro table all use it. ANY is form-only.
list_sections()
{
    cat <<END
ANY Search in All Sections
1 General Commands
2 System Calls
3 C Library Functions
3f Fortran Library Functions
3lua Lua Modules
4 Special Files and Hardware Support
5 File Formats
6 Games and Demos
7 Miscellaneous Information Pages
8 System Maintenance Commands
