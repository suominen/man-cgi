  </td></tr>
  <tr><td>Yandex:&nbsp;</td><td><a
    href="https://yandex.com/search/?text=site%3A$SERVER_NAME%20$COMMAND"
    ><tt>site:$SERVER_NAME $COMMAND</tt></a>
  </td></tr>
  </table>
</td></tr></table>
END
