#!/bin/sh
# Man-cgi : a Common Gateway Interface which converts the output of
#           the "man" command to HTML
#
# Author  : Panagiotis J. Christias <christia@theseas.ntua.gr>
#
# Usage   : it goes in the /cgi-bin/ directory. When called without 
#           arguments (https://www-server/cgi-bin/man-cgi) it outputs a
#           "Front Page" with a section list and query form. When called
#           with arguments, the first argument is the topic (e.g. ls)
#           and the second argument (optional) is the section to look in.
#
#           http://www.ntua.gr/~christia/man-cgi.html
#           XXX: Dead link detected 2017-04-15
#
#           Examples:
#               http://www.ntua.gr/cgi-bin/man-cgi?ls
#               http://www.ntua.gr/cgi-bin/man-cgi?sleep+3
#
# Notice  : Man-cgi uses the following two images, you may want to get them
#           and put them in your w3 server:
#               http://www.ntua.gr/images/doty.gif
#               http://www.ntua.gr/images/pages.gif
#
# History :
#   7.0     Handle multicharacter sections (e.g. intro(9lua)).
#   1.15    Multiple blank lines are supressed.
#   1.14    Man-cgi now recognizes cross-references that
#           contain periods (e.g. foo.foo(3)).
#   1.13    Really fixed problems occuring in pages which used
#           multi-overstrike for emboldening (hopefully).
#   1.12    Fixed problems occuring in pages which used multi-overstrike
#           for emboldening. Now Man-cgi works any number of overstrike.
#   1.11    Fixed problem with hyphenated cross-references.
#   1.10 and earlier, no history at that time...
#
# Last update: Sat Apr 15 2017
#

### CONFIGURATION SECTION : change the following variables to fit your needs ###

# The HTTPD server may not pass the enviroment variables to the script.
# You should add your system path here :
export PATH
PATH=/usr/local/bin:/bin:/usr/bin

# The same for the man path here :
#export MANPATH
#MANPATH=/usr/local/man:/usr/local/X/man:/usr/share/man:/usr/local/gnu/man

# Character set ISO-8859-1
export LC_CTYPE
LC_CTYPE=en_US.ISO8859-1
CHARSET=windows-1252

# OS details
OSARCH=$(uname -m)
OSNAME=$(uname -s)
OSREL=$(uname -r)

# Man page collections
MANROOT=/p/netbsd/www/man

# The URL of the two images :
DOT=/common/images/man-dot.gif
PAGES=/common/images/pages.gif

# Copyright year
CYEAR=$(date +%Y)

# Last modified is NetBSD-current build retrieval date
BUILDFILE="$MANROOT/NetBSD-current/build"
if [ -f "$BUILDFILE" ]
then
    eval $(stat -s "$BUILDFILE")
    LASTMOD=$(date -u -r "$st_mtime" '+%a, %d %b %Y %H:%M:%S GMT')
fi

# Expires date is 16 days in the future
EXPSECS=1382400
EXPDATE=$(($(date '+%s') + $EXPSECS))
EXPIRES=$(date -u -r "$EXPDATE" '+%a, %d %b %Y %H:%M:%S GMT')

### END OF CONFIGURATION SECTION ###############################################

canonical_url()
{
    local arch coll port section

    case "${SERVER_PORT:-443}" in
    443) port=;;
    *)  port=":${SERVER_PORT}";;
    esac

    case "$ARCH" in
    .*)
	arch="$(echo "$ARCH" | sed -e 's/^\.//')"
	;;
    *)
	arch="$ARCH"
	;;
    esac

    case "$SECTION.$arch" in
    ANY.DEFAULT)
	section=""
	;;
    *.DEFAULT|*.)
	section="+${SECTION}"
	;;
    ANY.*)
	section="+.${arch}"
	;;
    *)
	section="+${SECTION}.${arch}"
	;;
    esac

    case "$COLL" in
    +*)
	coll="$(echo "$COLL" | sed -e 's/^\+//')"
	;;
    *)
	coll="$COLL"
	;;
    esac

    case "$coll" in
    "")
	;;
    DEFAULT)
	coll=""
	;;
    *)
	case "$section" in
	"")
	    coll="++${coll}"
	    ;;
	*)
	    coll="+${coll}"
	    ;;
	esac
	;;
    esac

    echo "https://${SERVER_NAME}${port}${SCRIPT_NAME}?${COMMAND}${section}${coll}"
}

if [ $# -lt 2 ]
then
    QS="$(
	echo "${1:-${QUERY_STRING:-}}" \
	| sed \
	    -e 's/%20/+/g' \
	    -e 's/%2B/+/g' \
	    -e 's/%2b/+/g' \
	    -e 's/=$//' \
	    ;
    )"
    OIFS="$IFS"
    IFS="${OIFS}+"
    set -- ${QS}
    IFS="${OIFS}"
fi

COMMAND="${1##*/}"
SECTION="${2:-ANY}"
COLL="${3:-DEFAULT}"
ARCH=DEFAULT

set -- $COMMAND
COMMAND="$1"
set -- $SECTION
SECTION="$1"
set -- $COLL
COLL="$1"

echo "Content-Type: text/html; charset=$CHARSET"
if [ -n "$LASTMOD" ]
then
    echo "Last-Modified: $LASTMOD"
fi

case "$REQUEST_METHOD" in
POST)
    read a
    OIFS="$IFS"
    IFS="${OIFS}&+"
    set -- $a
    IFS="${OIFS}"

    for i
    do
	case "$i" in
	arch=*)
	    ARCH=$(echo "$i" | sed -e 's/arch=//')
	    ;;
	coll=*)
	    COLL=$(echo "$i" | sed -e 's/coll=//')
	    ;;
	command=*)
	    COMMAND=$(echo "$i" | sed -e 's/command=//' -e 's,%2F,/,gi')
	    ;;
	section=*)
	    SECTION=$(echo "$i" | sed -e 's/section=//')
	    ;;
	esac
    done

    ME="$(canonical_url)"

    echo "Location: $ME"
    echo ""
    echo 'Goto: <a href="'"$ME"'">'"$ME"'</a>'

    exit 0
    ;;
esac

case "$PATH_INFO" in
/apropos)
    MANPARAM="-k"
    echo 'X-Robots-Tag: noindex'
    ;;
esac

# Cache a lot
if [ "$COMMAND" != "" ]
then
    echo "Expires: $EXPIRES"
    echo "Cache-Control: public, max-age=$EXPSECS"
fi

case "$SECTION" in
.*)
    ARCH=$(echo $SECTION | sed -e 's/^\.//')
    SECTION=""
    ;;
*.*)
    ARCH=$(echo $SECTION | awk -F. '{print $2}')
    SECTION=$(echo $SECTION | awk -F. '{print $1}')
    ;;
esac
case "$SECTION" in
ANY)
    SECTION=""
    ;;
esac
case "$COLL" in
""|DEFAULT)
    COLL=""
    ;;
*)
    COLL=$(echo "$COLL" | tr -c -d '[-.A-Za-z0-9]')
    export MANPATH
    MANPATH="${MANROOT}/${COLL}"
    export GROFF_TMAC_PATH
    GROFF_TMAC_PATH="${MANPATH}/tmac"
    CNAME=$(echo $COLL | awk -F- '{print $1}')
    CREL=$(echo $COLL | sed -e 's/^[^-]*-//')
    COLL="+$COLL"
    ;;
esac
case "$ARCH" in
""|DEFAULT)
    ARCH=""
    ;;
*)
    export MACHINE
    case "$ARCH" in
    NONE)
	MACHINE=.
	;;
    *)
	MACHINE="$ARCH"
	;;
    esac
    ARCH=".$ARCH"
    ;;
esac

if [ "$COMMAND" != "" ]
then
    case "$SECTION" in
    "")
	if [ "$MANPARAM" = "" ]
	then
	    man -C "$MANROOT/man.conf" -w -- "$COMMAND" >/dev/null 2>&1
	    notfound=$?
	fi
	;;
    *)
	man -C "$MANROOT/man.conf" -w -- "$SECTION" "$COMMAND" >/dev/null 2>&1
	notfound=$?
	;;
    esac

    if [ ${notfound:-0} -ne 0 ]
    then
	echo 'Status: 404 Not Found'
    fi
fi

# End of headers
cat <<END

<!DOCTYPE HTML>
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=$CHARSET">
<style type="text/css">
<!--
body { background-color: #f0f0f0; color: #000000; }
a:link { color: #0000f0; }
a:visited { color: #6000c0; }
@media screen and (prefers-color-scheme: dark) {
    body { background-color: #303030; color: #c0c0c0; }
    a:link { color: #90c0f0; }
    a:visited { color: #c060c0; }
}
table { padding: 0; }
table.outer { width: 500px; }
th, td { border: 0; padding: 0; }
.intro th, .intro td { padding-left: 10px; }
b.section { font-size: 150%; }
.small { font-size: 80%; }
-->
</style>
END

if [ "$COMMAND" != "" ]
then
    cat <<END
<title>$COMMAND${SECTION:+"($SECTION)"} - ${CNAME:-"$OSNAME"} Manual Pages</title>
<link rel="shortcut icon" href="/${CNAME:-"$OSNAME"}.ico" type="image/x-icon">
END
    if [ ${notfound:-0} -eq 0 ]
    then
	if [ "$MANPARAM" = "" ]
	then
	    cat <<END
<link rel="canonical" href="$(canonical_url)">
END
	fi
    fi
    cat <<END
</head>
<body>
END
