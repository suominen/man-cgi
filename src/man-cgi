	;;
    esac

    case "${SECTION}" in
    "")
	SECTION="${LASTMODFILE##*.}"
	case "${SECTION}" in
	"")
	    ;;
	[1-9]|3f|[39]lua)
	    ME="$(canonical_url)"

	    echo 'Status: 303 See Other'
	    echo "Location: $ME"
	    echo
