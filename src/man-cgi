    ;;
esac

if ${need_redirect:-false}
then
    redirect 308
fi

case "${COMMAND}" in
'')
    # 1 hour
    EXPSECS=3600
    ;;
*)
    case "${SECTION}" in
    '')
	case "${MANPARAM}" in
	'')
	    LASTMODFILE=$(
		man -C "$MANROOT/man.conf" -w -- "$COMMAND" 2>/dev/null
