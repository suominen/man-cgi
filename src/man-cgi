		echo 'Status: 302 Found'
		echo "Location: $ME"
		echo
		echo 'Goto: <a href="'"$ME"'">'"$ME"'</a>'

		exit 0
	    fi
	    ;;
	*-[1-9].*|*-[1-9][0-9].*)
	    MINOR="$((${COLL##*.} + 0))"
	    case "${MINOR}" in
	    0)
		;;
	    *)
		NCOLL="${COLL%.*}.$((${MINOR} - 1))-STABLE"
		if [ -d "${MANROOT}/${NCOLL}" ]
		then
		    COLL="${NCOLL}"
		    ME="$(canonical_url)"

		    echo 'Status: 302 Found'
		    echo "Location: $ME"
		    echo
		    echo 'Goto: <a href="'"$ME"'">'"$ME"'</a>'

		    exit 0
		fi
		;;
	    esac
	    ;;
	esac
