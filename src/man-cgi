#!/bin/sh
#
# Convert output of man to HTML
#
# (c) 1994 Panagiotis J. Christias <christia@theseas.ntua.gr>
#	http://users.softlab.ntua.gr/~christia/man-cgi.html
#
# Modifications for NetBSD:
# (c) 1997-2025 Kimmo Suominen <kimmo@suominen.com>
#	https://kimmo.suominen.com/
#
# Usage:
#
#   PATH_INFO=/[COLLECTION/][ARCH/]COMMAND[.SECTION]
#
# Examples:
#
#   /boot.8
#   /boot
#   /i386/boot.8
#   /i386/boot
#   /NetBSD-9.0/boot.8
#   /NetBSD-9.0/boot
#   /NetBSD-9.0/i386/boot.8
#   /NetBSD-9.0/i386/boot
#
# Legacy usage:
#
#   QUERY_STRING=COMMAND[+[SECTION][.ARCH][+COLLECTION]]
#
# Examples:
#
#   boot+8
#   boot
#   boot+8.i386
#   boot+.i386
#   boot+8+NetBSD-9.0
#   boot++NetBSD-9.0
#   boot+8.i386+NetBSD-9.0
#   boot+.i386+NetBSD-9.0
#
# Health check:
#
#   PATH_INFO=/.well-known/health
#   QUERY_STRING=/.well-known/health
#

MANCGI_DATE=2026-08-11

### CONFIGURATION SECTION : change the following variables to fit your needs ###

# The HTTPD server may not pass the enviroment variables to the script.
# You should add your system path here :
#
# Outside a gateway context (e.g. the test harness) MANCGI_PATH,
# MANCGI_MANROOT, and MANCGI_MINLASTMOD may override the fixed
# values.
case "${GATEWAY_INTERFACE:-}" in
'')
    ;;
*)
    unset MANCGI_PATH MANCGI_MANROOT MANCGI_MINLASTMOD
    ;;
esac
export PATH
PATH=${MANCGI_PATH:-/usr/local/bin:/bin:/usr/bin}

# The same for the man path here :
#export MANPATH
#MANPATH=/usr/local/man:/usr/local/X/man:/usr/share/man:/usr/local/gnu/man

# Character set ISO-8859-1
export LC_CTYPE
LC_CTYPE=en_US.ISO8859-1
CHARSET=windows-1252

# OS details
OSARCH=$(uname -m)
OSNAME=$(uname -s)
OSREL=$(uname -r)

# Man page collections
MANROOT=${MANCGI_MANROOT:-/p/netbsd/man/man}

# Last modified is NetBSD-current build retrieval date
LASTMODFILE="$MANROOT/NetBSD-current/build"

# Floor for Last-Modified on rendered output (seconds since the
# epoch, UTC): every validator is max(file mtime, MINLASTMOD).
# Bump to the checkin time (date +%s) whenever a script change
# alters rendered output: the sed HTMLizer, the section list,
# query-form defaults (ANY/NONE/DEFAULT), cache headers, canonical
# URLs, page chrome, error bodies. Signature and MANCGI_DATE
# changes do not qualify.
# 2026-08-11 09:53:26 UTC
MINLASTMOD=${MANCGI_MINLASTMOD:-1786442006}

### END OF CONFIGURATION SECTION ###############################################

healthcheck()
{
    local code text

    test -d "${MANROOT}" &&
    test -f "${LASTMODFILE}" &&
    { code=200; text=OK; } ||
    { code=503; text='Service Unavailable'; }

    echo "Status: ${code} ${text}"
    echo "X-Powered-By: man-cgi (${MANCGI_DATE})"
    echo 'Content-Type: text/plain'

    emit_cache_headers health

    # End of headers
    echo ''
    echo "${text}"

    exit 0
}

canonical_url()
{
    local arch coll port section

    case "${REQUEST_SCHEME:-http}" in
    https)
	case "${SERVER_PORT:-443}" in
	443)	port=;;
	*)	port=":${SERVER_PORT}";;
	esac
	;;
    *)
	case "${SERVER_PORT:-80}" in
	80)	port=;;
	*)	port=":${SERVER_PORT}";;
	esac
	;;
    esac

    case "${COLL}" in
    DEFAULT|"${DEFAULT_COLLECTION}"|"")
	coll=
	;;
    *)
	coll="${COLL}"
	;;
    esac

    case "${ARCH}" in
    DEFAULT|"${DEFAULT_ARCH}"|"")
	arch=
	;;
    *)
	arch="${ARCH}"
	;;
    esac

    case "$SECTION" in
    ANY|"")
	section=
	;;
    *)
	section="${SECTION}"
	;;
    esac

    case "${COMMAND}" in
    "")
	echo "${REQUEST_SCHEME:-http}://${SERVER_NAME}${port}${SCRIPT_NAME}?+${section}${arch:+.$arch}+${coll}"
	;;
    *)
	# XXX: We should probably have some configurable prefix, too.
	echo "${REQUEST_SCHEME:-http}://${SERVER_NAME}${port}${coll:+/$coll}${arch:+/$arch}/${COMMAND}${section:+.$section}"
	;;
    esac
}

rel_canonical_url()
{
    # Assumptions:
    # - Also serving over https, so advertise it as canonical
    # - Only using non-standard ports for development, so
    #   they are not seen by search engines

    local arch
    arch="$(echo "${ARCH}" | sed -e 's/,/\\,/g')"
    canonical_url \
    | sed -e "
	s/^http:/https:/
	s,:[1-9][0-9]*/,/,
	${ARCH:+s,/${arch}/,/${CANONICAL_ARCH:-${arch}}/,}
	s,/NONE/,/,
    "
}

list_archs()
{
    case "${DEFAULT_ARCH}" in
    "")
	echo DEFAULT
	;;
    esac
    echo NONE
    cat "${MANROOT}/archlist"
}

list_collections()
{
    case "${DEFAULT_COLLECTION}" in
    "")
	echo DEFAULT
	;;
    esac
    cat "${MANROOT}/colllist"
}

# One shared section list: the /api/v1/sectlist endpoint, the query
# form, and the intro table all use it. ANY is form-only.
list_sections()
{
    cat <<END
ANY Search in All Sections
1 General Commands
2 System Calls
3 C Library Functions
3f Fortran Library Functions
3lua Lua Modules
4 Special Files and Hardware Support
5 File Formats
6 Games and Demos
7 Miscellaneous Information Pages
8 System Maintenance Commands
9 Kernel Internals
9lua Lua Kernel Bindings
END
}

# Serve one of the /api/v1 list endpoints: newline-delimited
# text/plain, revalidatable via Last-Modified (the list file's
# mtime clamped to MINLASTMOD; MINLASTMOD alone for the embedded
# sectlist).
api_list()
{
    local file lastmod

    # Not inherited from the environment: empty means no validator.
    lastmod=

    APILIST="${1}"

    case "${APILIST}" in
    archlist|colllist)
	file="${MANROOT}/${APILIST}"
	st_mtime=
	if [ -f "${file}" ]
	then
	    eval $(stat -s "${file}")
	fi
	;;
    *)
	# The embedded sectlist has no backing file; MINLASTMOD
	# tracks output-affecting script changes.
	st_mtime="${MINLASTMOD}"
	;;
    esac

    # NB: archlist/colllist bodies also depend on DEFAULT_ARCH
    # and DEFAULT_COLLECTION (a DEFAULT line is synthesized when
    # unset), which the clamped file-mtime validator does not
    # cover: after changing those params, bump MINLASTMOD, touch
    # the list files, or purge the api key.
    if [ -n "${st_mtime}" ]
    then
	if [ "${st_mtime}" -lt "${MINLASTMOD}" ]
	then
	    st_mtime="${MINLASTMOD}"
	fi
	lastmod=$(date -u -r "${st_mtime}" '+%a, %d %b %Y %H:%M:%S GMT')
    fi

    case "${REQUEST_METHOD:-GET}" in
    GET|HEAD)
	if [ -n "${lastmod:-}" ] &&
	[ "${HTTP_IF_MODIFIED_SINCE:-}" = "${lastmod}" ]
	then
	    echo 'Status: 304 Not Modified'
	    echo "Last-Modified: ${lastmod}"
	    emit_cache_headers api

	    # End of headers; a 304 carries no body
	    echo ''
	    exit 0
	fi
	;;
    esac

    echo 'Content-Type: text/plain'
    if [ -n "${lastmod:-}" ]
    then
	echo "Last-Modified: ${lastmod}"
    fi
    emit_cache_headers api

    # End of headers
    echo ''

    case "${REQUEST_METHOD:-GET}" in
    HEAD)
	;;
    *)
	case "${APILIST}" in
	archlist)
	    list_archs
	    ;;
	colllist)
	    list_collections
	    ;;
	sectlist)
	    list_sections
	    ;;
	esac
	;;
    esac

    exit 0
}

# Unknown /api paths must not fall through to page parsing (they
# would be canonicalized into man-page redirects).
api_notfound()
{
    echo 'Status: 404 Not Found'
    echo 'Content-Type: text/plain'
    emit_cache_headers api-notfound

    # End of headers
    echo ''

    case "${REQUEST_METHOD:-GET}" in
    HEAD)
	;;
    *)
	echo 'Not found'
	;;
    esac

    exit 0
}

