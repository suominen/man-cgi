	    COLL="${1}"
	    shift
	    ;;
	esac
	while [ ${#} -gt 2 ]
	do
	    need_redirect=true
	    shift
	done
	ARCH="${1}"
	COMMAND="${2}"
	;;
    esac
    ;;
esac

