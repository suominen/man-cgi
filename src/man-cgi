# Reduce man -w output (one path per line, in man(1) search order)
# to one token per manual page: [<arch>/]<name>.<section>.
#
# The section comes from the manN/catN directory rather than from
# the file suffix, so a preformatted page (catN/name.0) and its
# source (manN/name.N) collapse to the same token; man(1) lists
# both, and they are one page. The arch, when there is one, is the
# subdirectory between them. Reading the path from its tail keeps
# this right in the no-DEFAULT_COLLECTION configuration the
# CANONICAL_ARCH derivation's XXX warns about.
match_tokens()
{
    local arch base dir name path sect

    while read -r path
    do
	base="${path##*/}"
	name="${base%.*}"
	dir="${path%/*}"
	sect="${dir##*/}"
	arch=
	# The section directories are manN and catN for the sections
	# list_sections() carries, plus the n and l directories
	# man.conf's _subdir names. Spelled out rather than globbed:
	# man[0-9]* would also take man10, and cat* would take cats,
	# which is an architecture.
	case "${sect}" in
	man[1-9]|man3f|man[39]lua|man[ln]|cat[1-9]|cat3f|cat[39]lua|cat[ln])
	    ;;
	*)
	    # An arch or machine-class subdirectory: the section
	    # directory is its parent.
	    arch="${sect}"
	    dir="${dir%/*}"
	    sect="${dir##*/}"
	    ;;
	esac
	sect="${sect#man}"
	sect="${sect#cat}"
	printf '%s\n' "${arch:+$arch/}${name}.${sect}"
    done \
    | awk '!seen[$0]++'
}

# Render match tokens as linked list entries. Sections n and l are
# not in list_sections(); mann/manl are recognised above only so
# those directories are not mistaken for arches, and a link to one
# would not route through this script's URL parser. No collection
# served here has such directories.
list_matches()
{
    local name sect token

    while read -r token
    do
	name="${token%.*}"
	sect="${token##*.}"
	printf '%s\n' \
	    "<li><a href=\"/${COLL:+$COLL/}${name}.${sect}\">${name}($sect)</a></li>"
    done
}

queryform()
{
    local archattr coll collattr focusattr safearch

    # The home page is the form, so autofocus there. Elsewhere it
    # would steal the scroll keys from the reader; the inline
    # script's / shortcut focuses the field instead.
    case "${CLASS}" in
    home)	focusattr=" autofocus";;
    *)		focusattr=;;
    esac

    cat <<END
<div class="queryform">
<form method=post action="$SCRIPT_NAME">
  <div>
    <label for="command">Command:&nbsp;&nbsp;&nbsp;&nbsp;</label>
    <input name="command" id="command" size="24" type="text"
      value="$COMMAND"${focusattr}>
  </div>
  <div>
    <label for="section">Section:&nbsp;&nbsp;&nbsp;</label>
    <select name="section" id="section">
END

    list_sections |
    while read -r s d
    do
	case "$s" in
	"$SECTION")
	    echo "      <option value=\"$s\" selected>$s - $d</option>"
	    ;;
	*)
	    echo "      <option value=\"$s\">$s - $d</option>"
	    ;;
	esac
    done

    # ARCH is a raw URL path segment; reflect it into HTML only
    # when it is a plain arch token (same guard as the arch
    # Surrogate-Key), never as arbitrary bytes.
    case "${ARCH}" in
    ''|*[!-.A-Za-z0-9_]*)	safearch=;;
    *)			safearch="${ARCH}";;
    esac
    case "${safearch}" in
    '')	archattr=;;
    *)	archattr=" data-url=\"${safearch}\"";;
    esac

    cat <<END
    </select>
  </div>
  <div>
    <label for="arch">Arch:&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</label>
    <select name="arch" id="arch"${archattr}>
END

    # Fallback options only: the inline script loads the full list
    # from /api/v1/archlist, so cached pages do not embed it.
    case "${DEFAULT_ARCH}" in
    '')
	echo "      <option value=\"DEFAULT\">DEFAULT ($OSARCH)</option>"
	;;
    esac
    echo '      <option value="NONE">NONE</option>'
    case "${safearch}" in
    '')
	;;
    *)
	echo "      <option value=\"$safearch\" selected>$safearch</option>"
	;;
    esac
    case "${COLL}" in
    '')	collattr=;;
    *)	collattr=" data-url=\"${COLL}\"";;
    esac

    cat <<END
    </select>
  </div>
  <div>
    <label for="coll">Collection:</label>
    <select name="coll" id="coll"${collattr}>
END

    # Fallback option: the resolved collection; the full list comes
    # from /api/v1/colllist.
    coll="${COLL:-${DEFAULT_COLLECTION:-DEFAULT}}"
    case "${coll}" in
    DEFAULT)
	echo "      <option value=\"DEFAULT\" selected>DEFAULT ($OSNAME-$OSREL)</option>"
	;;
    *)
	echo "      <option value=\"$coll\" selected>$coll</option>"
	;;
    esac

    cat <<END
    </select>
  </div>
  <div>
    <label for="submit"><span>&gt;&gt;&gt;</span></label>
    <input id="submit" type="submit" value="Show">
  </div>
END

    case "${DEFAULT_COLLECTION}" in
    "")
	cat <<END
  <p>Use the DEFAULT collection to view manual pages
  for third-party software.</p>
END
	;;
    esac

    cat <<END
</form>
</div>
END

    js_queryform
}

# Emit the inline script that populates the arch and collection
# selects from /api/v1 and remembers the choices in localStorage
# (no cookies: nothing varies at any cache tier). Preselection
# order: URL-carried value (data-url), remembered value, default.
# Without JavaScript the fallback options keep the form usable.
#
# The script also makes / focus the command field (and select its
# text, so typing replaces the page's own name), as on GitHub and
# MDN, and Escape the way back out: focus returns to the page so
# the scroll keys work again. It listens on keydown by key name
# rather than key code, and does not exclude Shift: / is Shift-7
# on Finnish and Swedish layouts, and e.key is still '/'. Only
# controls that take text keep / for themselves; from the selects
# and the Show button, where tabbing through the form ends, it
# still reaches the shortcut. The default action is cancelled only
# when focus actually moves (a hidden form leaves / to the browser,
# where Firefox opens Quick Find on it), and the field is focused
# without scrolling: below 800px the form is not sticky, and
# focusing it would scroll a deep-read page back to the top (the
# field is then off screen until the first typed character brings
# the caret into view, which costs an accidental / nothing). A held
# / auto-repeats into the now-focused field, so its repeats are
# swallowed until the key is released. The "Press / to focus"
# tooltip is added here rather than in the markup, so it is only
# promised where the script runs and the field is not already
# autofocused.
js_queryform()
{
    cat <<'END'
<script>
(function () {
  function remember(key, value) {
    try {
      localStorage.setItem('man-cgi.' + key, value);
    } catch (e) {}
  }

  function recall(key) {
    try {
      return localStorage.getItem('man-cgi.' + key);
    } catch (e) {
      return null;
    }
  }

  function fill(name, fallback) {
    var sel = document.getElementById(name);
    if (!sel || !window.fetch) {
      return;
    }
    fetch('/api/v1/' + name + 'list').then(function (r) {
      if (!r.ok) {
        throw new Error(r.status);
      }
      return r.text();
    }).then(function (text) {
      var names = text.split('\n');
      var want = sel.getAttribute('data-url') || recall(name) || fallback;
      var i, opt;
      sel.options.length = 0;
      for (i = 0; i < names.length; i++) {
        if (!names[i]) {
          continue;
        }
        opt = document.createElement('option');
        opt.value = names[i];
        opt.textContent = names[i];
        if (names[i] === want) {
          opt.selected = true;
        }
        sel.appendChild(opt);
      }
    }).catch(function (e) {});
  }

  var arch, cmd, held = false, heldCode;

  document.addEventListener('keydown', function (e) {
    var t = e.target;
    if (e.key === 'Escape' && !e.isComposing && t && t.id === 'command') {
      t.setSelectionRange(t.value.length, t.value.length);
      t.blur();
      return;
    }
    if (e.key !== '/' || e.ctrlKey || e.metaKey || e.altKey ||
        e.isComposing) {
      return;
    }
    if (held && e.repeat) {
      e.preventDefault();
      return;
    }
    if (t && (t.tagName === 'TEXTAREA' || t.isContentEditable ||
        (t.tagName === 'INPUT' &&
         !/^(button|checkbox|radio|reset|submit)$/i.test(t.type)))) {
      return;
    }
    if (!cmd) {
      return;
    }
    cmd.focus({preventScroll: true});
    if (document.activeElement === cmd) {
      e.preventDefault();
      cmd.select();
      held = true;
      heldCode = e.code;
    }
  });

  document.addEventListener('keyup', function (e) {
    if (e.key === '/' || (heldCode && e.code === heldCode)) {
      held = false;
    }
  });

  window.addEventListener('blur', function () {
    held = false;
  });

  cmd = document.getElementById('command');
  if (cmd && !cmd.autofocus) {
    cmd.title = 'Press / to focus';
  }

  fill('arch', 'NONE');
  fill('coll', '');
  arch = document.getElementById('arch');
  if (arch && arch.form) {
    arch.form.addEventListener('submit', function () {
      var coll = document.getElementById('coll');
      remember('arch', arch.value);
      if (coll) {
        remember('coll', coll.value);
      }
    });
  }
})();
</script>
END
}

# Emit the caching headers for a response of the given content
# class: health, home, redirect-found, redirect-permanent, page,
# or notfound.
emit_cache_headers()
{
    local accel class coll expdate expires expsecs keys surrogate
    class="${1}"

    coll="${COLL:-${DEFAULT_COLLECTION:-DEFAULT}}"

    # Each cache tier gets its own lifetime: Cache-Control reaches
    # browsers (and is the fallback for the other tiers),
    # X-Accel-Expires is consumed by nginx, Surrogate-Control by
    # Fastly. Browsers cache briefly (they cannot be purged), nginx
    # briefly (expiry costs only a 304 revalidation), Fastly long
    # (purgeable by Surrogate-Key).
    case "${class}" in
    api)
	# 1 hour; a week at Fastly
	expsecs=3600
	accel=3600
	surrogate='max-age=604800, stale-while-revalidate=3600'
	;;
    health)
	# 30 seconds everywhere
	expsecs=30
	accel=30
	surrogate='max-age=30'
	;;
    home)
	# 2 hours; a day at Fastly
	expsecs=7200
	accel=7200
	surrogate='max-age=86400, stale-while-revalidate=3600'
	;;
    notfound|api-notfound)
	# 1 hour; a day at Fastly (a rebuild can add the page)
	expsecs=3600
	accel=3600
	surrogate='max-age=86400, stale-if-error=86400'
	;;
    redirect-found)
	# 1 hour for browsers (the tier that cannot be purged), 3
	# hours at nginx, a day at Fastly: this is the "not yet a
	# release" redirect, and it has to stop within hours of the
	# release tree landing (ADR-0015). It is also the cheapest
	# response the script makes, emitted before man -w, so a
	# refetch costs less than a 404 revalidation.
	expsecs=3600
	accel=10800
	surrogate='max-age=86400'
	;;
    redirect-permanent)
	# 24 hours for browsers and nginx; 30 days at Fastly, where
	# the redirect key purges. nginx never revalidates a cached
	# redirect, so its expiry is a full refetch -- cheap, at most
	# one man -w -- and a day bounds how long a redirect that
	# should no longer exist keeps being served (ADR-0015). 301
	# is in Fastly's default-cacheable status set; 308 was not,
	# which is why these redirects are 301s (ADR-0005).
	expsecs=86400
	accel=86400
	surrogate='max-age=2592000'
	;;
    *)
	# page: the resolved collection decides
	case "${coll}" in
	*-current|*-BRANCH)
	    # Rebuilt frequently: 1 hour for browsers and nginx,
	    # a day at Fastly
	    expsecs=3600
	    accel=3600
	    surrogate='max-age=86400, stale-while-revalidate=3600'
	    surrogate="${surrogate}, stale-if-error=604800"
	    ;;
	*)
	    # Frozen release: a day for browsers and nginx,
	    # 90 days at Fastly
	    expsecs=86400
	    accel=86400
	    surrogate='max-age=7776000, stale-while-revalidate=86400'
	    surrogate="${surrogate}, stale-if-error=604800"
	    ;;
	esac
	;;
    esac

    # Surrogate-Key tokens for purging at Fastly. The page key is
    # arch-free so all arch aliases of a machine-independent page
    # purge together; arch keys carry the requested arch (guarded
    # against unsafe characters: PATH_INFO is user input) and the
    # canonical arch when it differs (e.g. the x86 machine class).
    case "${class}" in
    api)
	keys="all api form ${APILIST}"
	;;
    api-notfound)
	keys='all api notfound'
	;;
    health)
	keys='all'
	;;
    home)
	keys="all home coll:${coll}"
	;;
    notfound)
	keys="all notfound coll:${coll}"
	;;
    menu)
	# The page key is sectionless: a menu is about the name,
	# not about any one section of it.
	keys="all menu coll:${coll} page:${coll}:${COMMAND}"
	case "${ARCH}" in
	''|*[!-.A-Za-z0-9_]*)
	    ;;
	*)
	    keys="${keys} arch:${ARCH}"
	    ;;
	esac
	;;
    redirect-found|redirect-permanent)
	keys="all redirect coll:${coll}"
	;;
    *)
	# page
	keys="all coll:${coll}"
	keys="${keys} page:${coll}:${COMMAND}${SECTION:+.${SECTION}}"
	case "${ARCH}" in
	''|*[!-.A-Za-z0-9_]*)
	    ;;
	*)
	    keys="${keys} arch:${ARCH}"
	    ;;
	esac
	case "${CANONICAL_ARCH:-NONE}" in
	NONE|"${ARCH}")
	    ;;
	*)
	    keys="${keys} arch:${CANONICAL_ARCH}"
	    ;;
	esac
	;;
    esac

    expdate=$(($(date '+%s') + expsecs))
    expires=$(date -u -r "${expdate}" '+%a, %d %b %Y %H:%M:%S GMT')

    echo "Expires: ${expires}"
    echo "Cache-Control: public, max-age=${expsecs}"
    echo "X-Accel-Expires: ${accel}"
    echo "Surrogate-Control: ${surrogate}"
    echo "Surrogate-Key: ${keys}"
}

redirect()
{
    local class
    ME="$(canonical_url)"
    case "${1}" in
    303)
	# POST (form query)
	echo 'Status: 303 See Other'
	;;
    301)
	class=redirect-permanent
	echo 'Status: 301 Moved Permanently'
	;;
    *)
	# Collection not found
	class=redirect-found
	echo 'Status: 302 Found'
	;;
    esac
    echo "Location: $ME"
    echo "Content-Type: text/html; charset=$CHARSET"
    case "$REQUEST_METHOD" in
    POST)
	echo 'Cache-Control: no-store'
	;;
    *)
	emit_cache_headers "${class}"
	;;
    esac

    # End of headers
    cat <<END

<html><body>

<!-- -------------------------------------------------------------------- -->

<p>Goto: <a
href="$ME"
>$ME</a></p>

<!-- -------------------------------------------------------------------- -->

END
    signature
    echo '</body></html>'
    exit 0
}

signature()
{
    cat <<END
<p class="powered">Powered by man-cgi (${MANCGI_DATE}).
Maintained for <a href="${REQUEST_SCHEME:-http}://www.netbsd.org/">NetBSD</a>
by <a href="https://kimmo.suominen.com/">Kimmo Suominen</a>.
Based on <a href="http://users.softlab.ntua.gr/~christia/man-cgi.html"
>man-cgi</a> by <a href="http://users.softlab.ntua.gr/~christia/"
>Panagiotis Christias</a>.</p>
END
}

case "$PATH_INFO" in
/.well-known/health)
    healthcheck
    ;;
/api/v1/archlist|/api/v1/colllist|/api/v1/sectlist)
    api_list "${PATH_INFO##*/}"
    ;;
/api/*)
    api_notfound
    ;;
''|/)
    if [ $# -lt 2 ]
    then
	QS="$(
	    echo "${1:-${QUERY_STRING:-}}" \
	    | sed \
		-e 's/%20/+/g' \
		-e 's/%2B/+/gi' \
		-e 's/=$//' \
		;
	)"
	OIFS="$IFS"
	IFS="${OIFS}+"
	set -- ${QS}
	IFS="${OIFS}"
    fi

    COMMAND="${1}"
    SECTION="${2:-ANY}"
    COLL="${3:-DEFAULT}"
    ARCH=DEFAULT

    case "${COMMAND}" in
    /.well-known/health)
	healthcheck
	;;
    /api/*)
	api_notfound
	;;
    '')
	# An empty name with a query string is the legacy form of a
	# collection's index (ADR-0017); the bare URL is the home page.
	case "${QS:-}" in
	'')
	    ;;
	*)
	    need_redirect=true
	    ;;
	esac
	;;
    *)
	need_redirect=true
	;;
    esac
    ;;
*)
    OIFS="$IFS"
    IFS="${OIFS}/"
    set -- ${PATH_INFO}
    IFS="${OIFS}"
    shift

    SECTION=ANY
    COLL=DEFAULT
    ARCH=DEFAULT

    # A leading component that starts with an uppercase letter is
    # the collection. Alone, only when it is shaped like one,
    # NAME-REL with a numeric release or current: a page name can
    # start with an uppercase letter too -- Mail(1), X(7), the X11
    # API -- and asked for alone it has no collection in front of
    # it. No page in any served collection has the collection
    # shape (ADR-0017).
    case ${#} in
    1)
	case "${1}" in
	[A-Z]*-[0-9]*|[A-Z]*-current)
	    COLL="${1}"
	    shift
	    ;;
	esac
	;;
    *)
	case "${1}" in
	[A-Z]*)
	    COLL="${1}"
	    shift
	    ;;
	esac
	;;
    esac

    # Extra components collapse from the front: the last two are
    # the arch and the name.
    while [ ${#} -gt 2 ]
    do
	need_redirect=true
	shift
    done

    # Of two components, the first is the arch.
    case ${#} in
    2)
	ARCH="${1}"
	shift
	;;
    esac

    # What is left is the name, or nothing: the collection's index.
    # A name in archlist is an arch, not a page -- archlist is the
    # set sanitize_arch validates against, so the names the form
    # offers and the names a URL treats as an arch are one set --
    # and a page named like an arch has to be asked for with its
    # section (ADR-0017). Behind an arch it is still not a page
    # name, and the arch in front is the one judged.
    case "${1}" in
    '')
	COMMAND=
	# An empty component, a doubled slash, is an alias.
	case ${#} in
	0)
	    ;;
	*)
	    need_redirect=true
	    ;;
	esac
	;;
    *)
	if in_archlist "${1}"
	then
	    case "${ARCH}" in
	    DEFAULT)
		ARCH="${1}"
		;;
	    esac
	    COMMAND=
	else
	    COMMAND="${1}"
	fi
	;;
    esac

    # The trailing slash is invisible to the split above, so it is
    # judged here: an index ends in one and a page does not
    # (ADR-0017). An index carries no arch, and the default
    # collection's index is / -- which the first arm serves, so a
    # DEFAULT collection here is never canonical.
    case "${COMMAND}" in
    '')
	case "${PATH_INFO}" in
	*/)
	    ;;
	*)
	    need_redirect=true
	    ;;
	esac
	case "${ARCH}" in
	DEFAULT)
	    ;;
	*)
	    need_redirect=true
	    ;;
	esac
	case "${COLL}" in
	DEFAULT|"${DEFAULT_COLLECTION}")
	    need_redirect=true
	    ;;
	esac
	;;
    *)
	case "${PATH_INFO}" in
	*/)
	    need_redirect=true
	    ;;
	esac
	;;
    esac
    ;;
esac

#case "$PATH_INFO" in
#/apropos)
#    MANPARAM="-k"
#    echo 'X-Robots-Tag: noindex'
#    ;;
#esac

set -- $COMMAND
COMMAND="$1"
set -- $SECTION
SECTION="$1"
set -- $COLL
COLL="$1"

# Not inherited from the environment: these are the sanitizers'
# verdicts on this request, and an inherited value would decide a
# response class.
BADCOLL=
BADARCH=
BADCOMMAND=
BADSECTION=

case "$REQUEST_METHOD" in
POST)
    read -r a
    OIFS="$IFS"
    IFS="${OIFS}&+"
    set -- $a
    IFS="${OIFS}"

    for i
    do
	# Every value is scrubbed of control characters as it is
	# taken, before the sanitizers below judge it. A body line's
	# own terminator arrives as part of the last field it parsed
	# (the split set has no CR), and that is framing rather than
	# anything the client chose: sanitize_arch drops a value it
	# would have to change, so leaving the CR in would throw away
	# a perfectly good architecture. The field names are matched
	# before the scrub, so a mangled name stays mangled.
	case "$i" in
	arch=*)
	    ARCH="$(printf '%s' "${i#arch=}" | tr -d '\000-\037\177')"
	    ;;
	coll=*)
	    COLL="$(printf '%s' "${i#coll=}" | tr -d '\000-\037\177')"
	    ;;
	command=*)
	    # Scrubbed here and judged by sanitize_command below: the
	    # scrub is about the header's line structure, the judgement
	    # about what a name may hold.
	    COMMAND="$(
		printf '%s' "${i#command=}" \
		| sed \
		    -e 's,%2F,/,gi' \
		    -e 's,%2B,+,gi' \
		    -e 's,%5B,[,gi' \
		    -e 's,%5D,],gi' \
		| tr -d '\000-\037\177'
	    )"
	    ;;
	section=*)
	    SECTION="$(printf '%s' "${i#section=}" | tr -d '\000-\037\177')"
	    ;;
	esac
    done

    # The section is judged here rather than by sanitize_section:
    # it still holds the form's ANY, and the SECTION.ARCH split
    # below has not happened yet, so the set is the arch one. Not
    # only the body's field -- a body without one leaves whatever
    # the legacy query string parsed above. A rejected section
    # degrades to ANY, the form's own default, rather than being
    # repaired: the same rule as every other value on this arm.
    case "${SECTION}" in
    *[!-.A-Za-z0-9_]*)
	SECTION=ANY
	;;
    esac

    # Scrubbed but not yet judged, and the 303 quotes all four
    # into a header and its body.
    #
    # The body is the only one of the three entry forms that can
    # hold a raw control character in practice -- nginx passes
    # PATH_INFO and QUERY_STRING undecoded and rejects a request
    # line carrying one -- so the control-character scrub lives
    # here rather than on the shared path below. That is a
    # property of the front end, not of this script: decode
    # PATH_INFO at the front end and the other two need the same
    # treatment. The section was judged just above; the name's
    # sanitizer runs here as it does on the shared path.
    sanitize_coll
    sanitize_arch
    sanitize_command

    redirect 303
    ;;
esac

# Early enough that the DEFAULT_COLLECTION mapping below sees a
# name that is either a collection name or DEFAULT, never the
# remains of one.
sanitize_coll

case "$SECTION" in
.*)
    ARCH="${SECTION#.}"
    SECTION=
    ;;
*.*)
    ARCH="${SECTION##*.}"
    SECTION="${SECTION%%.*}"
    ;;
esac

case "$SECTION" in
ANY)
    SECTION=
    ;;
esac

# After the SECTION.ARCH split above and before the suffix split
# below, whose section has already matched the section patterns.
sanitize_section

case "$COMMAND" in
*.[1-9]|*.3f|*.[39]lua)
    SECTION="${COMMAND##*.}"
    COMMAND="${COMMAND%.*}"
    ;;
esac

case "$COMMAND" in
*/*)
    ARCH="${COMMAND%/*}"
    COMMAND="${COMMAND##*/}"
    ;;
esac

# After every path that can set it: the URL component and the
# legacy query string's SECTION.ARCH field. (The arch-prefixed
# COMMAND just above is reachable from the command line and from a
# literal / in the query string -- PATH_INFO is split on / before
# it gets here, QUERY_STRING is not %2F-decoded, and the POST arm
# returns at its 303.) The name is
# judged at the same point, once every split has taken its share.
sanitize_arch
sanitize_command

case "${DEFAULT_ARCH}" in
"")
    ;;
*)
    case "${ARCH}" in
    DEFAULT|"")
	ARCH="${DEFAULT_ARCH}"
	;;
    esac
    ;;
esac

case "$ARCH" in
DEFAULT|"")
    ARCH=
    ;;
*)
    export MACHINE
    MACHINE="$ARCH"
    ;;
esac

case "${ARCH}" in
"${DEFAULT_ARCH}")
    ARCH=
    ;;
esac

case "${DEFAULT_COLLECTION}" in
"")
    ;;
*)
    case "${COLL}" in
    DEFAULT|"")
	COLL="${DEFAULT_COLLECTION}"
	;;
    esac
    ;;
esac

case "${COLL}" in
DEFAULT|"")
    COLL=
    ;;
*)
    if [ ! -d "${MANROOT}/${COLL}" ]
    then
	NCOLL="${COLL%.*}.x-BRANCH"
	if [ -d "${MANROOT}/${NCOLL}" ]
	then
	    COLL="${NCOLL}"
	    redirect 302
	fi

	MINOR="${COLL##*.}"
	case "${MINOR}" in
	0)
	    NCOLL="${COLL%%-*}-current"
	    if [ -d "${MANROOT}/${NCOLL}" ]
	    then
		COLL="${NCOLL}"
		redirect 302
	    fi
	    ;;
	esac

	# No such collection and no name: there is no index to serve
	# and nothing to canonicalize (ADR-0017). With a name, man -w
	# answers the same 404 by itself.
	case "${COMMAND}" in
	'')
	    BADCOLL=true
	    ;;
	esac
    fi
    export MANPATH
    MANPATH="${MANROOT}/${COLL}"
    export GROFF_TMAC_PATH
    GROFF_TMAC_PATH="${MANPATH}/tmac"
    CNAME="${COLL%%-*}"
    CREL="${COLL#*-}"
    ;;
esac

case "${COLL}" in
"${DEFAULT_COLLECTION}")
    COLL=
    ;;
esac

# A name that is not a collection, an architecture, a page name or
# a section cannot be canonicalized: there is no page to point at,
# and a 301 outlives its fix by a day in browsers and nginx
# (ADR-0005, ADR-0015). Only the legacy query string and
# the POST body can produce a malformed collection -- the PATH_INFO
# parser takes one only from an [A-Z]* component, which always
# survives both the character set and the shape check -- though
# every form can name one that does not exist, which is rejected
# above when there is no page name to look up. Only the legacy
# query string can produce a bad section, but any entry form can
# produce a bad architecture or page name.
if rejected
then
    need_redirect=
fi

if ${need_redirect:-false}
then
    redirect 301
fi

# man -w can resolve one name to several files: an arch or
# machine-class page shadowing a machine-independent one, the same
# name existing in several sections, or a preformatted page listed
# beside its source. MATCHES holds one token per distinct page in
# man(1) search order, MATCHES_REST every one but the page that
# would be rendered (ADR-0012).
#
# Not inherited from the environment: MENU is run as a command, and
# CANONICAL_ARCH is read by rel_canonical_url() on the menu path,
# which is the one response class that emits a canonical link
# without having derived it.
MATCHES=
MATCHES_REST=
MENU=
CANONICAL_ARCH=

# Responses that describe the collection rather than one page --
# 404s and multi-match menus -- are validated by its
# tmac/mdoc.local. That file carries the upstream build's timestamp,
# the same one every page in the tree gets, so it moves exactly when
# the collection's contents move; build moves on every pull, new
# content or not. It is also present in every collection, where
# build exists only for NetBSD-current and the branches, so frozen
# releases stop going out with no validator at all.
COLLSTAMP="${MANROOT}/${COLL:-${DEFAULT_COLLECTION:-}}/tmac/mdoc.local"

# A literal newline, for testing whether man -w returned more than
# one path. Command substitution strips trailing newlines, so this
# cannot be written with printf.
NL='
'

case "${COMMAND}" in
'')
    # A collection's index is a collection-level response and takes
    # the collection's validator (ADR-0013); the home page keeps the
    # default collection's build file.
    case "${COLL}" in
    '')
	;;
    *)
	LASTMODFILE="${COLLSTAMP}"
	;;
    esac
    ;;
*)
    case "${SECTION}" in
    '')
	case "${MANPARAM}" in
	'')
	    LASTMODFILE=$(
		man -C "$MANROOT/man.conf" -w -- "$COMMAND" 2>/dev/null
	    )
	    notfound=$?
	    ;;
	esac
	;;
    *)
	LASTMODFILE=$(
	    man -C "$MANROOT/man.conf" -w -- "$SECTION" "$COMMAND" 2>/dev/null
	)
	notfound=$?
	;;
    esac

    if [ ${notfound:-0} -ne 0 ]
    then
	# Let 404s revalidate against the collection's own date
	LASTMODFILE="${COLLSTAMP}"
    else
	# Only a multi-line result is worth tokenising: one match is
	# already the page that will be rendered, and the MANPARAM
	# path leaves LASTMODFILE at its non-page default.
	case "${LASTMODFILE}" in
	*"${NL}"*)
	    MATCHES=$(printf '%s\n' "${LASTMODFILE}" | match_tokens)
	    MATCHES_REST=$(printf '%s\n' "${MATCHES}" | sed -e 1d)
	    ;;
	esac
    fi
    ;;
esac

# Whatever man(1) just said, a request whose collection,
# architecture, name or section did not survive validation has no
# page. (A well-formed name for a collection that merely does not
# exist is a different thing, and so is an architecture that is
# real but ships no pages of its own in this collection; both are
# left alone.) Every rejected value was reset first, so the
# response still gets a validator and cache keys that can be
# purged, but the lookup's result is not this request's answer.
if rejected
then
    notfound=1
    LASTMODFILE="${COLLSTAMP}"
    MATCHES=
    MATCHES_REST=
fi

# The page that gets rendered is the first path man(1) would find.
LASTMODFILE="$(printf '%s\n' "${LASTMODFILE}" | sed -e 1q)"

# A request that names no section and matches several pages gets a
# menu instead of a guess. Sectioned URLs keep the canonical-arch
# redirect (ADR-0009): an arch URL searches the arch directory, its
# machine class and the machine-independent directory, so it too
# can match several files, and a menu there would only lead back to
# itself. Pointing LASTMODFILE at the collection stamp both gives
# the menu its validator and skips the canonicalization block below.
case "${SECTION}" in
'')
    case "${MATCHES_REST}" in
    ?*)
	MENU=true
	LASTMODFILE="${COLLSTAMP}"
	;;
    esac
    ;;
esac

case "${LASTMODFILE}" in
*/build|*/tmac/mdoc.local)
    # Not a manual page: the home page's default, or the collection
    # stamp a 404 or a menu was given. Nothing to canonicalize.
    ;;
*)
    # XXX: This breaks when # DEFAULT_COLLECTION is not set
    # and the DEFAULT collection is used for system pages.

    CANONICAL_ARCH="${LASTMODFILE##${MANROOT}/}"
    CANONICAL_ARCH="${CANONICAL_ARCH#*/}"
    CANONICAL_ARCH="${CANONICAL_ARCH#*/}"
    case "${CANONICAL_ARCH}" in
    */*/*)
	# Too many!
	CANONICAL_ARCH=NONE
	;;
    */*)
	CANONICAL_ARCH="${CANONICAL_ARCH%/*}"
	;;
    *)
	CANONICAL_ARCH=NONE
	;;
    esac

    # Canonicalize the architecture: send each page to the URL
    # matching where man(1) resolved it. Machine-independent
    # pages (CANONICAL_ARCH=NONE) drop the arch; machine-
    # dependent pages keep or gain the resolved subdirectory's
    # arch. Setting ARCH before the section-inference redirect
    # folds both into a single hop.
    case "${CANONICAL_ARCH}" in
    NONE)	canarch=;;
    *)		canarch="${CANONICAL_ARCH}";;
    esac
    arch_changed=
    if [ "${ARCH}" != "${canarch}" ]
    then
	ARCH="${canarch}"
	arch_changed=true
    fi

    # Infer the section: a sectionless request that resolved to one
    # page is sent to that page's sectioned URL. The section is the
    # match token's (ADR-0016), read from the manN/catN directory,
    # so a page found as catN/name.0 redirects like manN/name.N
    # does; the .0 suffix names no section. Only the sections the
    # URL parser accepts redirect; a page in mann or manl stays at
    # its sectionless URL.
    case "${SECTION}" in
    "")
	SECTION="$(printf '%s\n' "${LASTMODFILE}" | match_tokens)"
	SECTION="${SECTION##*.}"
	case "${SECTION}" in
	[1-9]|3f|[39]lua)
	    redirect 301
	    ;;
	*)
	    SECTION=
	    ;;
	esac
	;;
    esac

    if ${arch_changed:-false}
    then
	redirect 301
    fi
    ;;
esac

if [ -f "$LASTMODFILE" ]
then
    eval $(stat -s "$LASTMODFILE")
    if [ "$st_mtime" -lt "$MINLASTMOD" ]
    then
	st_mtime="$MINLASTMOD"
    fi
    LASTMOD=$(date -u -r "$st_mtime" '+%a, %d %b %Y %H:%M:%S GMT')
