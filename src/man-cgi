#!/bin/sh
# Man-cgi : a Common Gateway Interface which converts the output of
#           the "man" command to HTML
#
VERSION="1.15"
#
# Author  : Panagiotis J. Christias <christia@theseas.ntua.gr>
#
# Usage   : it goes in the /cgi-bin/ directory. When called without 
#           arguments (http://www-server/cgi-bin/man-cgi) it outputs a
#           "Front Page" with a section list and query form. When called
#           with arguments, the first argument is the topic (e.g. ls)
#           and the second argument (optional) is the section to look in.
#
#           Examples:
#               http://www.ntua.gr/cgi-bin/man-cgi?ls
#               http://www.ntua.gr/cgi-bin/man-cgi?sleep+3
#
# Notice  : Man-cgi uses the following two images, you may want to get them
#           and put them in your w3 server:
#               http://www.ntua.gr/images/doty.gif
#               http://www.ntua.gr/images/pages.gif
#
# History :
#   1.15    Multiple blank lines are supressed.
#   1.14    Man-cgi now recognizes cross-references that
#           contain periods (e.g. foo.foo(3)).
#   1.13    Really fixed problems occuring in pages which used
#           multi-overstrike for emboldening (hopefully).
#   1.12    Fixed problems occuring in pages which used multi-overstrike
#           for emboldening. Now Man-cgi works any number of overstrike.
#   1.11    Fixed problem with hyphenated cross-references.
#   1.10 and earlier, no history at that time...
#
# Last update: Fri May 5 1995
#

### CONFIGURATION SECTION : change the following variables to fit your needs ###

# The HTTPD server may not pass the enviroment variables to the script.
# You should add your system path here :
export PATH
PATH=/usr/local/bin:/bin:/usr/bin

# The same for the man path here :
#export MANPATH
#MANPATH=/usr/local/man:/usr/local/X/man:/usr/share/man:/usr/local/gnu/man

# Character set ISO-8859-1
export LC_CTYPE
LC_CTYPE=en_US.ISO8859-1
CHARSET=iso-8859-1

# OS details
OSARCH=$(uname -m)
OSNAME=$(uname -s)
OSREL=$(uname -r)

# Man page collections
MANROOT=/proj/www/man

# The full URL of the Man-cgi :
MANCGI='/cgi-bin/man-cgi'

# The URL of the two images :
DOT=/common/images/man-dot.gif
PAGES=/common/images/pages.gif

# Copyright year
CYEAR=$(date +%Y)

# Last modified is NetBSD-current build retrieval date
BUILDFILE="$MANROOT/NetBSD-current/build"
if [ -f "$BUILDFILE" ]
then
    eval $(stat -s "$BUILDFILE")
    LASTMOD=$(date -u -r "$st_mtime" '+%a, %d %b %Y %H:%M:%S GMT')
fi

# Expires date is 16 days in the future
EXPSECS=1382400
EXPDATE=$(($(date '+%s') + $EXPSECS))
EXPIRES=$(date -u -r "$EXPDATE" '+%a, %d %b %Y %H:%M:%S GMT')

### END OF CONFIGURATION SECTION ###############################################

COMMAND=${1}
SECTION=${2:-ANY}
COLL=${3:-DEFAULT}
ARCH=DEFAULT

set -- $COMMAND
COMMAND=$1
set -- $SECTION
SECTION=$1
set -- $COLL
COLL=$1

echo "Content-Type: text/html; charset=$CHARSET"
if [ -n "$LASTMOD" ]
then
    echo "Last-Modified: $LASTMOD"
fi

case "$REQUEST_METHOD" in
POST)
    read a
    OIFS="$IFS"
    IFS="${OIFS}&+"
    set -- $a
    for i
    do
	case "$i" in
	arch=*)
	    ARCH=$(echo "$i" | sed -e 's/arch=//')
	    ;;
	coll=*)
	    COLL=$(echo "$i" | sed -e 's/coll=//')
	    ;;
	command=*)
	    COMMAND=$(echo "$i" | sed -e 's/command=//')
	    ;;
	section=*)
	    SECTION=$(echo "$i" | sed -e 's/section=//')
	    ;;
	esac
    done
    IFS="${OIFS}"
    case "$SERVER_PORT" in
    80) ;;
    *)  PORT=":${SERVER_PORT}";;
    esac
    case "$SECTION.$ARCH" in
    ANY.DEFAULT)
	SECTION=""
	;;
    *.DEFAULT)
	SECTION="+${SECTION}"
	;;
    ANY.*)
	SECTION="+.${ARCH}"
	;;
    *)
	SECTION="+${SECTION}.${ARCH}"
	;;
    esac
    case "$COLL" in
    DEFAULT)
	COLL=""
	;;
    *)
	case "$SECTION" in
	"")
	    COLL="++${COLL}"
	    ;;
	*)
	    COLL="+${COLL}"
	    ;;
	esac
    esac
    ME="http://${SERVER_NAME}${PORT}${SCRIPT_NAME}?${COMMAND}${SECTION}${COLL}"
    echo "Location: $ME"
    echo ""
    echo 'Goto: <a href="'"$ME"'">'"$ME"'</a>'
    exit 0
    ;;
esac

case "$PATH_INFO" in
/apropos)
    MANPARAM="-k"
    ;;
esac

# Cache a lot
echo "Expires: $EXPIRES"
echo "Cache-Control: public, max-age=$EXPSECS"

# End of headers
cat <<END

<!DOCTYPE HTML>
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=$CHARSET">
<style type="text/css">
<!--
table { padding: 0; }
table.outer { width: 500px; }
th, td { border: 0; padding: 0; }
b.section { font-size: 150%; }
.small { font-size: 80%; }
-->
</style>
END

case "$SECTION" in
.*)
    ARCH=$(echo $SECTION | sed -e 's/^\.//')
    SECTION=""
    ;;
*.*)
    ARCH=$(echo $SECTION | awk -F. '{print $2}')
    SECTION=$(echo $SECTION | awk -F. '{print $1}')
    ;;
esac
case "$SECTION" in
ANY)
    SECTION=""
    ;;
esac
case "$COLL" in
""|DEFAULT)
    COLL=""
    ;;
*)
    COLL=$(echo "$COLL" | tr -c -d '[-.A-Za-z0-9]')
    export MANPATH
    MANPATH="${MANROOT}/${COLL}"
    export GROFF_TMAC_PATH
    GROFF_TMAC_PATH="${MANPATH}/tmac"
    CNAME=$(echo $COLL | awk -F- '{print $1}')
    CREL=$(echo $COLL | sed -e 's/^[^-]*-//')
    COLL="+$COLL"
    ;;
esac
case "$ARCH" in
""|DEFAULT)
    ARCH=""
    ;;
*)
    export MACHINE
    case "$ARCH" in
    NONE)
	MACHINE=.
	;;
    *)
	MACHINE="$ARCH"
	;;
    esac
    ARCH=".$ARCH"
    ;;
esac

if [ "$COMMAND" != "" ]
then
    case "$SECTION" in
    "")
	if [ "$MANPARAM" = "" ]
	then
	    man -w -- "$COMMAND" >/dev/null 2>&1
	    notfound=$?
	fi
	;;
    *)
	man -w -- "$SECTION" "$COMMAND" >/dev/null 2>&1
	notfound=$?
	;;
    esac
    cat <<END
<title>$COMMAND${SECTION:+"($SECTION)"} - ${CNAME:-"$OSNAME"} Manual Pages</title>
<link rel="shortcut icon" href="/${CNAME:-"$OSNAME"}.ico" type="image/x-icon">
</head>
<body>
END
    if [ ${notfound:-0} -eq 0 ]
    then
	echo "<pre>"
	case "$SECTION" in
	"")
	    man $MANPARAM -- "$COMMAND" 2>/dev/null
	    ;;
	*)
	    man -- "$SECTION" "$COMMAND" 2>/dev/null
	    ;;
	esac | \
	sed \
	    -e '1n' \
	    -e '/- *$/N
{
s/\([0-9A-z][-,0-9A-z]*\)-\n\(  *\)\([0-9A-z][-,0-9A-z]*([1-9][A-z]*)\)/\1\3\
\2/
}' \
	    -e '/- *$/N
{
s/\([0-9A-z][-,0-9A-z]*\)-\n\(  *\)\([0-9A-z][-,0-9A-z]*([1-9][A-z]*)\)/\1\3\
\2/
}' \
	    -e '/- *$/N
{
s/\([0-9A-z][-,0-9A-z]*\)-\n\(  *\)\([0-9A-z][-,0-9A-z]*([1-9][A-z]*)\)/\1\3\
\2/
}' \
	    -e '/- *$/N
{
s/\([0-9A-z][-,0-9A-z]*\)-\n\(  *\)\([0-9A-z][-,0-9A-z]*([1-9][A-z]*)\)/\1\3\
\2/
}' \
	    -e 's/</«/g' \
	    -e 's/>/»/g' \
   \
	    -e '/^[A-Z]/s/.//g' \
	    -e 's/^[A-Z][-+() ,A-Z_]*$/<b class="section">&<\/b>/' \
   \
	    -e 's/_\(.\)/<i>\1<\/i>/g' \
	    -e 's/.\(.\)/<b>\1<\/b>/g' \
   \
	    -e 's#<i>\(.\)</i<b>\1</b>#<b>\1</b>#g' \
	    -e 's#</b><b>.##g' \
	    -e 's#</b>.<b>##g' \
	    -e 's#.##g' \
	    -e 's#_</i<b><</b>i>##g'  \
   \
	    -e 's#</i>\( *\)<i>#\1#g' \
	    -e 's#</b>\( *\)<b>#\1#g' \
   \
	    -e 's#</b><i>\(.\)</i><b>#\1#g' \
   \
	    -e 's/^  \([A-Z][ ,0-9A-z_]*\)$/  <b>\1<\/b>/' \
	    -e 's/^   \([A-Z][ ,0-9A-z_]*\)$/   <b>\1<\/b>/' \
   \
	    -e "/^  */s#\(\(<[bi]>\)*\([0-9A-z_][-.,0-9A-z_]*\) *\(</[bi]>\)* *(\([1-9]\)[A-z]*)\)#<a href=\"$MANCGI\?\3+\5$ARCH$COLL\">\1</a>#g" \
   \
	    -e 's/\&/\&amp;/g' \
	    -e 's/«/\&lt;/g' \
	    -e 's/»/\&gt;/g' \
	    -e "s#^\(\([0-9A-z_][-0-9A-z_]*\) *(\([1-9]\)[A-z_]*)\)#<a href=\"$MANCGI\?\2+\3$ARCH$COLL\">\1</a>#" \
	    2>/dev/null
	echo "</pre>"
    else
	case "$ARCH$COLL" in
	"")
	    SECTION=""
	    ;;
	*)
	    SECTION="+"
	    ;;
	esac
	cat <<END
<p>The manual page was not found.
<a href="$MANCGI/apropos?$COMMAND$SECTION$ARCH$COLL">Try
apropos</a> or select a different architecture.</p>
END
    fi
else
    cat <<END
<title>${CNAME:-"$OSNAME"} Manual Pages</title>
<link rel="shortcut icon" href="/${CNAME:-"$OSNAME"}.ico" type="image/x-icon">
</head>
<body>
<table class="outer"><tr><td>
<h1><img alt="" src=$PAGES> ${CNAME:-"$OSNAME"} Manual Pages</h1>
<b>${CNAME:-"$OSNAME"} ${CREL:-"$OSREL"} (${MACHINE:-"$OSARCH"})</b>
<hr>
<p>Here are the intro pages of each section:</p>
<ol>
<li><a href="$MANCGI?intro+1$ARCH$COLL">GENERAL COMMANDS</a></li>
<li><a href="$MANCGI?intro+2$ARCH$COLL">SYSTEM CALLS AND ERROR NUMBERS</a></li>
<li><a href="$MANCGI?intro+3$ARCH$COLL">C LIBRARY FUNCTIONS</a></li>
<li><a href="$MANCGI?intro+4$ARCH$COLL">SPECIAL FILES AND HARDWARE SUPPORT</a></li>
<li><a href="$MANCGI?intro+5$ARCH$COLL">FILE FORMATS</a></li>
<li><a href="$MANCGI?intro+6$ARCH$COLL">GAMES AND DEMOS</a></li>
<li><a href="$MANCGI?intro+7$ARCH$COLL">MISCELLANEOUS INFORMATION PAGES</a></li>
<li><a href="$MANCGI?intro+8$ARCH$COLL">SYSTEM MAINTENANCE COMMANDS</a></li>
<li><a href="$MANCGI?intro+9$ARCH$COLL">KERNEL INTERNALS</a></li>
</ol>
END
    case "$ARCH$COLL" in
    "")
	cat <<END
<ul>
<li><a href="$MANCGI?X+X11">X WINDOW SYSTEM</a></li>
</ul>
END
	;;
    esac
    cat <<END
<p class="small">Sometimes man pages are not stored in the right section
and you may get an empty page. Follow the link at the top of the empty page
and you'll get your man page (hopefully).</p>
</td></tr></table>
END
fi
cat <<END
<table class="outer"><tr><td>
<hr>
<p>You can also request any man page by name and (optionally) by section:</p>
<form method=post action="$MANCGI/man">
  <table>
  <tr><td>Command:&nbsp;</td><td><input name="command" size="24"
  value="$COMMAND"></td></tr>
  <tr><td>Section:&nbsp;</td><td><select name="section">
END
for i in ANY:ANY \
    1:1 2:2 3:3 3f:3f 4:4 5:5 6:6 7:7 8:8 9:9 n:n l:l \
    X:X11R6 \
    games:games \
    local:local \
    pkg:packages \
    perl:perl \
    std:system
do
    OIFS="$IFS"
    IFS=":$IFS"
    eval set -- $i
    IFS="$OIFS"
    case "$1" in
    "$SECTION")
	echo "  <option value=\"$1\" selected>$2</option>"
	;;
    *)
	echo "  <option value=\"$1\">$2</option>"
	;;
    esac
done
cat <<END
  </select></td></tr>
  <tr><td>Architecture:&nbsp;</td><td><select name="arch">
END
for i in DEFAULT NONE $(cat $MANROOT/archlist)
do
    case ".$i" in
    .DEFAULT)
	echo "  <option value=\"DEFAULT\">DEFAULT ($OSARCH)</option>"
	;;
    "$ARCH")
	echo "  <option value=\"$i\" selected>$i</option>"
	;;
    *)
	echo "  <option value=\"$i\">$i</option>"
	;;
    esac
done
cat <<END
  </select></td></tr>
  <tr><td>Collection:&nbsp;</td><td><select name="coll">
END
for i in DEFAULT $(cat $MANROOT/colllist)
do
    case "+$i" in
    +DEFAULT)
	echo "  <option value=\"$i\">$i ($OSNAME-$OSREL)</option>"
	;;
    "$COLL")
	echo "  <option value=\"$i\" selected>$i</option>"
	;;
    *)
	echo "  <option value=\"$i\">$i</option>"
	;;
    esac
done
cat <<END
  </select></td></tr>
  <tr><td>&nbsp;</td>
  <td><input type="submit" value="Show manual page"></td></tr>
  </table>
  <p>Use the DEFAULT collection to view manual pages
  for third-party software.</p>
  <hr>
</form>
</td></tr></table>
<address class="small">
&copy;1994 <a href="http://www.ntua.gr/~christia/man-cgi.html">Man-cgi
$VERSION</A>, Panagiotis Christias &lt;christia@softlab.ntua.gr&gt;<br>
