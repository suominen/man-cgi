queryform()
{
    cat <<END
<div class="queryform">
<form method=post action="$SCRIPT_NAME">
  <table>
  <tr>
    <th>Command:</th>
    <th>Section:</th>
    <th>Arch:</th>
    <th>Collection:</th>
    <th>&nbsp;<!-- submit --></th>
  </tr>
    <td><input name="command" size="24" value="$COMMAND"></td>
    <td><select name="section">
END

    # XXX: Create a seclist and use that?
    for i in \
	'ANY Search in All Sections' \
	'1 General Commands' \
	'2 System Calls' \
	'3 C Library Functions' \
	'3f Fortran Library Functions' \
	'3lua Lua Modules' \
	'4 Special Files and Hardware Support' \
	'5 File Formats' \
	'6 Games and Demos' \
	'7 Miscellaneous Information Pages' \
	'8 System Maintenance Commands' \
	'9 Kernel Internals' \
	'9lua Lua Kernel Bindings' \
	;
    do
	set -- ${i}
	s="${1}"
	shift
	case "$s" in
	"$SECTION")
	    echo "      <option value=\"$s\" selected>$s - $@</option>"
	    ;;
	*)
	    echo "      <option value=\"$s\">$s - $@</option>"
	    ;;
	esac
    done

    cat <<END
    </select></td>
    <td><select name="arch">
END

    for i in $(list_archs)
    do
	case "$i" in
	DEFAULT)
	    echo "      <option value=\"DEFAULT\">DEFAULT ($OSARCH)</option>"
	    ;;
	"${ARCH}")
	    echo "      <option value=\"$i\" selected>$i</option>"
	    ;;
	*)
	    echo "      <option value=\"$i\">$i</option>"
	    ;;
	esac
    done

    cat <<END
    </select></td>
    <td><select name="coll">
END

    for i in $(list_collections)
    do
	case "$i" in
	DEFAULT)
	    echo "      <option value=\"$i\">$i ($OSNAME-$OSREL)</option>"
	    ;;
	"$COLL")
	    echo "      <option value=\"$i\" selected>$i</option>"
	    ;;
	*)
	    echo "      <option value=\"$i\">$i</option>"
	    ;;
	esac
    done

    cat <<END
    </select></td>
    <td><input type="submit" value="Show"></td>
  </tr>
  </table>
END

    case "${DEFAULT_COLLECTION}" in
    "")
	cat <<END
  <p>Use the DEFAULT collection to view manual pages
  for third-party software.</p>
END
	;;
    esac

    cat <<END
</form>
</div>
END
}

