END
for i in ANY:ANY \
    1:1 2:2 3:3 3f:3f 3lua:3lua 4:4 5:5 6:6 7:7 8:8 9:9 9lua:9lua l:l n:n \
    X:X11R7 \
    X11R6:X11R6 \
    games:games \
    local:local \
    perl:perl \
    pkg:packages \
    std:system
do
    OIFS="$IFS"
    IFS=":$IFS"
    set -- $i
    IFS="$OIFS"
    case "$1" in
    "$SECTION")
	echo "  <option value=\"$1\" selected>$2</option>"
	;;
    *)
	echo "  <option value=\"$1\">$2</option>"
	;;
    esac
done
cat <<END
