}

# Serve one of the /api/v1 list endpoints: newline-delimited
# text/plain, revalidatable via Last-Modified (the list file's
# mtime clamped to MINLASTMOD; MINLASTMOD alone for the embedded
# sectlist).
api_list()
{
    local file lastmod

    # Not inherited from the environment: empty means no validator.
    lastmod=

    APILIST="${1}"

    case "${APILIST}" in
    archlist|colllist)
	file="${MANROOT}/${APILIST}"
	st_mtime=
	if [ -f "${file}" ]
	then
	    eval $(stat -s "${file}")
	fi
	;;
    *)
	# The embedded sectlist has no backing file; MINLASTMOD
	# tracks output-affecting script changes.
	st_mtime="${MINLASTMOD}"
	;;
    esac

    # NB: archlist/colllist bodies also depend on DEFAULT_ARCH
    # and DEFAULT_COLLECTION (a DEFAULT line is synthesized when
    # unset), which the clamped file-mtime validator does not
    # cover: after changing those params, bump MINLASTMOD, touch
    # the list files, or purge the api key.
    if [ -n "${st_mtime}" ]
    then
	if [ "${st_mtime}" -lt "${MINLASTMOD}" ]
	then
	    st_mtime="${MINLASTMOD}"
	fi
	lastmod=$(date -u -r "${st_mtime}" '+%a, %d %b %Y %H:%M:%S GMT')
    fi

    case "${REQUEST_METHOD:-GET}" in
    GET|HEAD)
	if [ -n "${lastmod:-}" ] &&
	[ "${HTTP_IF_MODIFIED_SINCE:-}" = "${lastmod}" ]
	then
	    echo 'Status: 304 Not Modified'
	    echo "Last-Modified: ${lastmod}"
	    emit_cache_headers api

	    # End of headers; a 304 carries no body
	    echo ''
	    exit 0
	fi
	;;
    esac

    echo 'Content-Type: text/plain'
    if [ -n "${lastmod:-}" ]
    then
	echo "Last-Modified: ${lastmod}"
    fi
    emit_cache_headers api

    # End of headers
    echo ''

    case "${REQUEST_METHOD:-GET}" in
    HEAD)
	;;
    *)
	case "${APILIST}" in
	archlist)
	    list_archs
	    ;;
	colllist)
	    list_collections
	    ;;
	sectlist)
	    list_sections
	    ;;
	esac
	;;
    esac

    exit 0
}

# Unknown /api paths must not fall through to page parsing (they
# would be canonicalized into man-page redirects).
api_notfound()
{
    echo 'Status: 404 Not Found'
    echo 'Content-Type: text/plain'
    emit_cache_headers api-notfound

    # End of headers
    echo ''

    case "${REQUEST_METHOD:-GET}" in
    HEAD)
	;;
    *)
	echo 'Not found'
	;;
    esac

    exit 0
}

