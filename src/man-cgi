### END OF CONFIGURATION SECTION ###############################################

canonical_url()
{
    local arch coll port section

    case "${REQUEST_SCHEME:-http}" in
    https)
	case "${SERVER_PORT:-443}" in
	443)	port=;;
	*)	port=":${SERVER_PORT}";;
	esac
	;;
    *)
	case "${SERVER_PORT:-80}" in
	80)	port=;;
	*)	port=":${SERVER_PORT}";;
	esac
	;;
    esac

    case "${COLL}" in
    DEFAULT|"${DEFAULT_COLLECTION}"|"")
	coll=
	;;
    *)
	coll="${COLL}"
	;;
    esac

    case "${ARCH}" in
    DEFAULT|"${DEFAULT_ARCH}"|"")
	arch=
	;;
    *)
	arch="${ARCH}"
	;;
    esac

    case "$SECTION" in
    ANY|"")
	section=
	;;
    *)
	section="${SECTION}"
	;;
    esac

    case "${COMMAND}" in
    "")
	echo "${REQUEST_SCHEME-:http}://${SERVER_NAME}${port}${SCRIPT_NAME}?+${section}${arch:+.$arch}+${coll}"
	;;
    *)
	# XXX: We should probably have some configurable prefix, too.
	echo "${REQUEST_SCHEME-:http}://${SERVER_NAME}${port}${coll:+/$coll}${arch:+/$arch}/${COMMAND}${section:+.$section}"
	;;
    esac
}

rel_canonical_url()
{
    # Assumptions:
    # - Also serving over https, so advertise it as canonical
    # - Only using non-standard ports for development, so
    #   they are not seen by search engines

    canonical_url \
    | sed -e "
	s/^http:/https:/
	s,:[1-9][0-9]*/,/,
	s,/${ARCH}/,/${CANONICAL_ARCH:-$ARCH}/,
	s,/NONE/,/,
    "
}

list_archs()
{
    case "${DEFAULT_ARCH}" in
    "")
	echo DEFAULT
	;;
    esac
    echo NONE
    cat "${MANROOT}/archlist"
}

list_collections()
{
    case "${DEFAULT_COLLECTION}" in
    "")
	echo DEFAULT
	;;
    esac
    cat "${MANROOT}/colllist"
}

case "$PATH_INFO" in
''|/)
    if [ $# -lt 2 ]
    then
	QS="$(
	    echo "${1:-${QUERY_STRING:-}}" \
	    | sed \
		-e 's/%20/+/g' \
		-e 's/%2B/+/g' \
		-e 's/%2b/+/g' \
		-e 's/=$//' \
		;
	)"
	OIFS="$IFS"
	IFS="${OIFS}+"
	set -- ${QS}
	IFS="${OIFS}"
    fi

    COMMAND="${1}"
    SECTION="${2:-ANY}"
    COLL="${3:-DEFAULT}"
    ARCH=DEFAULT

    case "${COMMAND}" in
    "")
	;;
    *)
	need_redirect=true
	;;
    esac
    ;;
*)
    OIFS="$IFS"
    IFS="${OIFS}/"
    set -- ${PATH_INFO}
    IFS="${OIFS}"
    shift

    SECTION=ANY
    COLL=DEFAULT
    ARCH=DEFAULT

    case ${#} in
    1)
	COMMAND="${1}"
	;;
    2)
	COMMAND="${2}"
	case "${1}" in
	[A-Z]*)
	    COLL="${1}"
	    ;;
	*)
	    ARCH="${1}"
	    ;;
	esac
	;;
    *)
	COLL="${1}"
	while [ ${#} -gt 3 ]
	do
	    need_redirect=true
	    shift
	done
	ARCH="${2}"
	COMMAND="${3}"
	;;
    esac
    ;;
esac

