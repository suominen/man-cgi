	;;
    esac

    if [ ${notfound:-0} -ne 0 ]
    then
	echo 'Status: 404 Not Found'
	# 10 minutes
	EXPSECS=600
    fi
    ;;
esac

LASTMODFILE="$(echo "$LASTMODFILE" | sed -e 1q)"

case "${LASTMODFILE}" in
*/build)
    ;;
*)
    # XXX: This breaks when # DEFAULT_COLLECTION is not set
    # and the DEFAULT collection is used for system pages.

    CANONICAL_ARCH="${LASTMODFILE##${MANROOT}/}"
    CANONICAL_ARCH="${CANONICAL_ARCH#*/}"
    CANONICAL_ARCH="${CANONICAL_ARCH#*/}"
