expires()
{
    case "${EXPSECS:-}" in
    '')
	case "${COLL}" in
	*-current|*-BRANCH)
	    # 8 hours
	    EXPSECS=28800
	    ;;
	*)
	    # 16 days
	    EXPSECS=1382400
	    ;;
	esac
	;;
    esac

    EXPDATE=$(($(date '+%s') + $EXPSECS))
    EXPIRES=$(date -u -r "$EXPDATE" '+%a, %d %b %Y %H:%M:%S GMT')

    echo "Expires: $EXPIRES"
    echo "Cache-Control: public, max-age=$EXPSECS"
}

redirect()
{
    ME="$(canonical_url)"
    case "${1}" in
    303)
	echo 'Status: 303 See Other'
	;;
    308)
	echo 'Status: 308 Permanent Redirect'
	;;
    *)
	echo 'Status: 302 Found'
	;;
    esac
    echo "Location: $ME"
    expires

    # End of headers
    cat <<END

<html><body>

<!-- -------------------------------------------------------------------- -->

<p>Goto: <a
href="$ME"
>$ME</a></p>

<!-- -------------------------------------------------------------------- -->

END
    signature
    echo '</body></html>'
    exit 0
}

