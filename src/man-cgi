	CANONICAL_ARCH=NONE
	;;
    */*)
	CANONICAL_ARCH="${CANONICAL_ARCH%/*}"
	;;
    *)
	CANONICAL_ARCH=NONE
	;;
    esac

    case "${SECTION}" in
    "")
	SECTION="${LASTMODFILE##*.}"
	case "${SECTION}" in
	"")
	    ;;
	[1-9]|3f|[39]lua)
	    redirect 308
	    ;;
	*)
	    SECTION=
	    ;;
	esac
	;;
    esac
    ;;
esac

if [ -f "$LASTMODFILE" ]
then
    eval $(stat -s "$LASTMODFILE")
    LASTMOD=$(date -u -r "$st_mtime" '+%a, %d %b %Y %H:%M:%S GMT')
    if [ -n "$LASTMOD" ]
    then
	echo "Last-Modified: $LASTMOD"
    fi
fi

expires

# End of headers
