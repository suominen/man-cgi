	    then
		man -C "$MANROOT/man.conf" -- "$COMMAND" 2>/dev/null
	    else
		man -C "$MANROOT/man.conf" $MANPARAM -- "$COMMAND" 2>&1
	    fi
	    ;;
	*)
	    man -C "$MANROOT/man.conf" -- "$SECTION" "$COMMAND" 2>/dev/null
	    ;;
	esac | \
	sed \
	    -e '1n' \
	    -e '/- *$/N
{
s/\([0-9A-z][-,0-9A-z]*\)-\n\(  *\)\([0-9A-z][-,0-9A-z]*([1-9][A-z]*)\)/\1\3\
\2/
}' \
	    -e '/- *$/N
{
s/\([0-9A-z][-,0-9A-z]*\)-\n\(  *\)\([0-9A-z][-,0-9A-z]*([1-9][A-z]*)\)/\1\3\
\2/
}' \
	    -e '/- *$/N
{
s/\([0-9A-z][-,0-9A-z]*\)-\n\(  *\)\([0-9A-z][-,0-9A-z]*([1-9][A-z]*)\)/\1\3\
\2/
}' \
	    -e '/- *$/N
{
s/\([0-9A-z][-,0-9A-z]*\)-\n\(  *\)\([0-9A-z][-,0-9A-z]*([1-9][A-z]*)\)/\1\3\
\2/
}' \
	    -e 's/</«/g' \
	    -e 's/>/»/g' \
   \
	    -e '/^[A-Z]/s/.//g' \
	    -e 's/^[A-Z][-+() ,A-Z_]*$/<b class="section">&<\/b>/' \
   \
	    -e 's/_\(.\)/<i>\1<\/i>/g' \
	    -e 's/.\(.\)/<b>\1<\/b>/g' \
   \
	    -e 's#<i>\(.\)</i<b>\1</b>#<b>\1</b>#g' \
	    -e 's#</b><b>.##g' \
	    -e 's#</b>.<b>##g' \
	    -e 's#.##g' \
	    -e 's#_</i<b><</b>i>##g'  \
   \
	    -e 's#</i>\( *\)<i>#\1#g' \
	    -e 's#</b>\( *\)<b>#\1#g' \
   \
	    -e 's#</b><i>\(.\)</i><b>#\1#g' \
   \
	    -e 's/^  \([A-Z][ ,0-9A-z_]*\)$/  <b>\1<\/b>/' \
	    -e 's/^   \([A-Z][ ,0-9A-z_]*\)$/   <b>\1<\/b>/' \
   \
	    -e "/^  */s#\(\(<[bi]>\)*\([0-9A-z_][-.,0-9A-z_/]*\) *\(</[bi]>\)* *(\([1-9][A-z]*\))\)#<a href=\"$SCRIPT_NAME\?\3+\5$ARCH$COLL\">\1</a>#g" \
   \
	    -e 's/\&/\&amp;/g' \
	    -e 's/«/\&lt;/g' \
	    -e 's/»/\&gt;/g' \
	    -e "s#^\(\([0-9A-z_][-0-9A-z_/]*\) *(\([1-9][A-z_]*\))\)#<a href=\"$SCRIPT_NAME\?\2+\3$ARCH$COLL\">\1</a>#" \
	    2>/dev/null
	echo "</pre>"
    else
	case "$ARCH$COLL" in
	"")
	    SECTION=""
	    ;;
	*)
	    SECTION="+"
	    ;;
	esac
	cat <<END
<table class="outer"><tr><td>
<p>The manual page was not found. Try searching instead:</p>
  <table>
  <tr><td>Bing:&nbsp;</td><td><a
    href="https://bing.com/search?q=site%3A$SERVER_NAME%20$COMMAND"
    ><tt>site:$SERVER_NAME $COMMAND</tt></a>
  </td></tr>
  <tr><td>DuckDuckGo:&nbsp;</td><td><a
    href="https://duckduckgo.com/?q=site%3A$SERVER_NAME%20$COMMAND"
    ><tt>site:$SERVER_NAME $COMMAND</tt></a>
  </td></tr>
  <tr><td>Google:&nbsp;</td><td><a
    href="https://google.com/search?q=site%3A$SERVER_NAME%20$COMMAND"
    ><tt>site:$SERVER_NAME $COMMAND</tt></a>
  </td></tr>
  <tr><td>Qwant:&nbsp;</td><td><a
    href="https://qwant.com/?q=site%3A$SERVER_NAME%20$COMMAND"
    ><tt>site:$SERVER_NAME $COMMAND</tt></a>
  </td></tr>
  <tr><td>Yahoo:&nbsp;</td><td><a
    href="https://search.yahoo.com/search?p=site%3A$SERVER_NAME%20$COMMAND"
