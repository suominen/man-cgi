#!/bin/sh
# @(#)$KimmoSuominen$
#
# The home/query page: caching headers, Last-Modified from the
# default collection's build file, the intro table, and the query
# form with server-rendered fallback selects (full arch/collection
# lists come from /api/v1 via the inline script).
#
# 20260809  Kimmo Suominen
#

set -eu

CDPATH=

TESTS_DIR=$(cd "$(dirname "${0}")/.." && pwd)
. "${TESTS_DIR}/lib.sh"

test_init

run_cgi /

assert_exit 0
assert_no_header '^Status:'
assert_header '^Content-Type: text/html; charset=windows-1252$'
assert_header "^Last-Modified: ${LM_BUILD}\$"
assert_header '^Cache-Control: public, max-age=7200$'
assert_header '^X-Accel-Expires: 7200$'
assert_header '^Surrogate-Control: max-age=86400, stale-while-revalidate=3600, stale-if-error=604800$'
assert_no_header '^X-Powered-By:'
assert_body '<title>NetBSD Manual Pages</title>'
assert_body 'href="/afterboot.8"'
assert_body_absent 'rel="canonical"'

# The arch and collection lists are no longer embedded: the server
# renders fallback options only (NONE; the resolved collection) and
# the inline script loads the full lists from /api/v1.
assert_body '<option value="NONE">NONE</option>'
assert_body '<option value="NetBSD-current" selected>NetBSD-current</option>'
assert_body_absent '<option value="i386">'
assert_body_absent '<option value="NetBSD-10.1">'
assert_body "fetch('/api/v1/'"
assert_body 'persistent() ? localStorage : sessionStorage'
# localStorage appears only for the remember opt-in and for the
# one-time cleanup of the pre-ADR-0021 keys.
assert_body 'localStorage.removeItem'
assert_body "localStorage.getItem('man-cgi.remember')"
assert_body "addEventListener('submit'"
# The remember opt-in row: revealed by the script (hidden without
# JS, where it would do nothing), never submitted (no name), and
# unticked in the cached markup so ticking it is the affirmative
# act the consent requires.
assert_body '<div class="remember" hidden>'
assert_body '<input id="remember" type="checkbox"'
assert_body 'Remember arch and collection across visits'
assert_body 'Nothing is sent to the server'
assert_body_absent 'name="remember"'
assert_body_absent 'type="checkbox" checked'
assert_body_absent 'checked>'
assert_body_before '<div class="remember" hidden>' '<input id="remember"'
assert_body '<script>'
assert_body '</script>'
# The home page is the form, so the command field autofocuses.
assert_command_autofocus ''
# The tooltip advertising / is the script's to add where the field
# is not autofocused; the server does not render it.
assert_body_absent 'title="Press / to focus"'
# No URL carried a collection or arch, so neither select has a
# data-url attribute (the fallback when nothing is remembered).
# The bare word still appears in the script, so match the attribute.
assert_body_absent 'data-url="'
# The section select stays fully server-rendered on every page.
assert_body '<option value="8">8 - System Maintenance Commands</option>'

# The intro table and the form's section select share one section
# list (mixed case; the old uppercase intro copy is gone). ANY
# stays in the select but not the table; 3f is table-skipped.
assert_body 'intro.1'
assert_body '>General Commands</a>'
assert_body '<option value="3lua">3lua - Lua Modules</option>'
assert_body '<option value="ANY">ANY - Search in All Sections</option>'
assert_body_absent 'GENERAL COMMANDS'
assert_body_absent 'intro\.ANY'
assert_body_absent 'intro\.3f'

# The empty PATH_INFO form of the home page behaves the same.
run_cgi ''

assert_exit 0
assert_no_header '^Status:'
assert_header "^Last-Modified: ${LM_BUILD}\$"
assert_header '^Cache-Control: public, max-age=7200$'
assert_body 'href="/afterboot.8"'

test_done
