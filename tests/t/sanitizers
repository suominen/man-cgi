#!/bin/sh
# @(#)$KimmoSuominen$
#
# Characterize the sanitizers: collection, architecture, name and
# section are each filtered to their own character set, and the
# first two then checked for shape, on every entry path. A value
# that fails is dropped whole -- a collection, name or section that
# is not one is a 404; an architecture that is not one is a 404 as
# well. The POST body is the only input nginx will forward a raw
# control character in, so its fields are scrubbed before the 303
# quotes them into a header. (The CGI itself will take one from
# QUERY_STRING as happily; nginx rejects the request long before
# that.)
#
# 20260824  Kimmo Suominen
#

set -eu

CDPATH=

TESTS_DIR=$(cd "$(dirname "${0}")/.." && pwd)
. "${TESTS_DIR}/lib.sh"

test_init

# --- Collection: names that are not collection names -----------------

# '..' survives the character filter and is a real directory, so
# it satisfies the -d probe and would point MANPATH one level
# above MANROOT. It is a 404, not a redirect to /../ls.1.
CGI_QUERY='ls+1+..'
run_cgi ''

assert_exit 0
assert_header '^Status: 404 Not Found$'
assert_no_header '^Location:'
assert_header '^Surrogate-Key: all notfound coll:NetBSD-current$'
assert_header "^Last-Modified: ${LM_MDOC}\$"

# A collection of exactly -n: echo(1) consumed it as an option --
# NetBSD sh's echo prints nothing at all for it -- so the value
# came out empty and the request silently became the default
# collection. What this pins is the shape check, which refuses -n
# and the empty string alike; the printf half of the fix is only
# observable through PATH_INFO, below.
CGI_QUERY='ls+1+-n'
run_cgi ''

assert_exit 0
assert_header '^Status: 404 Not Found$'
assert_no_header '^Location:'
assert_header '^Surrogate-Key: all notfound coll:NetBSD-current$'

# '.' is the other name that is a real directory: it resolves to
# MANROOT itself rather than to its parent.
CGI_QUERY='ls+1+.'
run_cgi ''

assert_exit 0
assert_header '^Status: 404 Not Found$'
assert_no_header '^Location:'
assert_header '^Surrogate-Key: all notfound coll:NetBSD-current$'

# Nothing survives the character filter. The empty result used to
# reach [ -d "${MANROOT}/" ], which succeeds, making MANPATH
# MANROOT itself while the response still claimed the default
# collection.
CGI_QUERY='+1+@@@'
run_cgi ''

assert_exit 0
assert_header '^Status: 404 Not Found$'
assert_header '^Surrogate-Key: all notfound coll:NetBSD-current$'

# The home page takes the same route: no COMMAND, so the class
# would otherwise be home, and the rejected name reached the
# markup as a data-url attribute.
CGI_QUERY='+1+..'
run_cgi ''

assert_exit 0
assert_header '^Status: 404 Not Found$'
assert_header '^Surrogate-Key: all notfound coll:NetBSD-current$'
assert_body_absent 'data-url="\.\."'

# --- Collection: names that are collection names ---------------------

# A real collection is untouched, and so is the release-to-branch
# fallback that runs after the sanitizer.
CGI_QUERY='ls+1+NetBSD-10.1'
run_cgi ''

assert_exit 0
assert_header '^Status: 301 Moved Permanently$'
assert_header '^Location: https://man\.netbsd\.org/NetBSD-10\.1/ls\.1$'

CGI_QUERY=

# Backslashes are not escape sequences. Whether echo(1) expands
# them is implementation-defined -- NetBSD sh leaves \t alone,
# dash makes it a tab -- so what the old sanitizer produced
# depended on the shell running the CGI. printf is the same
# everywhere, and the name stays whole enough to fail on its own
# merits instead of collapsing onto the real NetBSD-10.1.
#
# This has to arrive through PATH_INFO to reach the sanitizer at
# all: the legacy query string is pre-processed by an echo of its
# own further up, which expands the escape before COLL is ever
# assigned, and field splitting then eats the tab. That is a
# separate defect and not one this change touches.
run_cgi '/NetBSD-10.1\tJUNK/ls.1'

assert_exit 0
assert_header '^Status: 404 Not Found$'
assert_header '^Surrogate-Key: all notfound coll:NetBSD-10\.1tJUNK$'

run_cgi /NetBSD-9.3/ls.1

assert_exit 0
assert_header '^Status: 302 Found$'
assert_header '^Location: https://man\.netbsd\.org/NetBSD-9\.x-BRANCH/ls\.1$'

# --- Architecture ----------------------------------------------------

# A sectionless legacy query string puts everything after the dot
# in ARCH, which reached the Location header unfiltered: '.' came
# back as /./ls. A name that is not an architecture names nothing,
# so it is a 404 rather than a guess at which page was meant.
CGI_QUERY='ls+..'
run_cgi ''

assert_exit 0
assert_header '^Status: 404 Not Found$'
assert_no_header '^Location:'
assert_no_header ' arch:'

# Architectures and machine classes are spelled in lowercase, so
# an uppercase name is not one. (DEFAULT and NONE are the two
# names that are exempt.)
CGI_QUERY='ls+.I386'
run_cgi ''

assert_exit 0
assert_header '^Status: 404 Not Found$'

CGI_QUERY=

# The URL component is an architecture source too, and it was as
# unfiltered as the others: '..' became MACHINE, and the
# Surrogate-Key guard passes dots, so arch:.. could become a cache
# key.
run_cgi /../ls.1

assert_exit 0
assert_header '^Status: 404 Not Found$'
assert_no_header '^Location:'
assert_header '^Surrogate-Key: all notfound coll:NetBSD-current$'

# Shape alone would accept this one -- it is lowercase and inside
# the character set. archlist is what rejects it.
run_cgi /9foo/ls.1

assert_exit 0
assert_header '^Status: 404 Not Found$'

# Dropped whole rather than repaired: keeping the part that passes
# the filter would serve the x86 page to a request that never
# asked for x86, and reflect the invention back in the query form.
run_cgi '/x86!/boot.8'

assert_exit 0
assert_header '^Status: 404 Not Found$'
assert_body_absent 'x86'

# archlist is the union across every collection ($MANROOT/Makefile
# finds the arch directories under all of them at once), so it
# holds architectures that ship no pages of their own here. Those
# are still real names: the request resolves to the
# machine-independent page and canonicalizes to it, exactly as any
# other arch alias does (ADR-0009). Membership is the test, not
# whether the collection has a directory for it -- the fixture
# tree has no sparc anywhere.
run_cgi /sparc/ls.1

assert_exit 0
assert_header '^Status: 301 Moved Permanently$'
assert_header '^Location: https://man\.netbsd\.org/ls\.1$'

# A real architecture and a real machine class are untouched.
run_cgi /i386/apm.4

assert_exit 0
assert_no_header '^Status:'
assert_header '^Surrogate-Key: all coll:NetBSD-current page:NetBSD-current:apm\.4 arch:i386$'

run_cgi /x86/cpuctl.4

assert_exit 0
assert_no_header '^Status:'
assert_header '^Surrogate-Key: all coll:NetBSD-current page:NetBSD-current:cpuctl\.4 arch:x86$'

# --- Name ------------------------------------------------------------

# The name reaches <title>, <h1>, the query form's value attribute
# and the 404 page's search links, and reached them raw: this
# request came back with <h1 class="manpage"><b>zz. A name that is
# not one names nothing, so it is dropped whole and the request is
# a 404 whose chrome shows no name at all -- and whose body is the
# not-found text rather than the intro table an empty name used to
# select.
run_cgi '/<b>zz'

assert_exit 0
assert_header '^Status: 404 Not Found$'
assert_no_header '^Location:'
assert_header '^Surrogate-Key: all notfound coll:NetBSD-current$'
assert_header "^Last-Modified: ${LM_MDOC}\$"
assert_body '<title>NetBSD Manual Pages</title>'
assert_body '<h1>NetBSD Manual Pages</h1>'
assert_body 'value="" autofocus'
assert_body 'The manual page was not found'
assert_body_absent '<b>zz'
assert_body_absent 'class="intro"'
assert_body_absent 'site:'

# The form's value attribute is the one double-quoted sink.
run_cgi '/a"b'

assert_exit 0
assert_header '^Status: 404 Not Found$'
assert_body_absent 'a"b'

# The legacy query string answered this with a 301 to /<b>zz, held
# for 30 days in nginx's cache; there is no page to point at.
CGI_QUERY='<b>zz'
run_cgi ''

assert_exit 0
assert_header '^Status: 404 Not Found$'
assert_no_header '^Location:'
assert_body_absent '<b>zz'

CGI_QUERY=

# The set is what the served trees use: [A-Za-z0-9_.-] plus + and
# [ in the base system (c++, g++, the [.1 alias of test), @ and :
# in pkgsrc. A page named with them is served under its name.
run_cgi '/c++.1'

assert_exit 0
assert_no_header '^Status:'
assert_body '<title>c++(1) - NetBSD Manual Pages</title>'
assert_body 'value="c++"'

# No fixture: [ is a glob character to man(1), and whether it finds
# such a page is man's business. What this pins is that the name
# survives the filter to reach the chrome.
run_cgi '/[.1'

assert_exit 0
assert_header '^Status: 404 Not Found$'
assert_body '<tt>site:man.netbsd.org \[</tt>'

# --- Section ---------------------------------------------------------

# Only the legacy query string can put arbitrary text here, and it
# reaches the title as ls(<b>) whenever the request renders rather
# than redirects -- a bad collection is one way to make it render.
# The section is dropped whole, like the name: with it gone the
# request would otherwise be a sectionless ls, which is a 301 to
# a page the client did not ask for.
CGI_QUERY='ls+<b>'
run_cgi ''

assert_exit 0
assert_header '^Status: 404 Not Found$'
assert_no_header '^Location:'
assert_body '<title>ls - NetBSD Manual Pages</title>'
assert_header '^Surrogate-Key: all notfound coll:NetBSD-current$'
assert_body_absent 'ls(<b>)'

CGI_QUERY='ls+<b>+..'
run_cgi ''

assert_exit 0
assert_header '^Status: 404 Not Found$'
assert_body_absent 'ls(<b>)'

# The SECTION.ARCH split comes first, so the dot never reaches the
# section check and the arch half is judged by sanitize_arch.
CGI_QUERY='ls+1.i386'
run_cgi ''

assert_exit 0
assert_header '^Status: 301 Moved Permanently$'
assert_header '^Location: https://man\.netbsd\.org/i386/ls\.1$'

CGI_QUERY=

# --- POST: control characters in the body ----------------------------

# The body is split on IFS plus & and +; CR is in none of those,
# so a body line ending in one leaves a trailing CR on the last
# field it parsed, which the 303 then quotes into the Location
# header. Where that lands in the URL depends on the field, so
# most of these fail on the stray character mid-pattern rather
# than on the anchor; see the section case for the one that does
# not.
CGI_METHOD=POST

CGI_BODY=$(printf 'command=ls&section=1&arch=DEFAULT&coll=NetBSD-10.1\r')
run_cgi ''

assert_exit 0
assert_header '^Status: 303 See Other$'
assert_header '^Location: https://man\.netbsd\.org/NetBSD-10\.1/ls\.1$'

CGI_BODY=$(printf 'command=ls&section=ANY&coll=DEFAULT&arch=i386\r')
run_cgi ''

assert_exit 0
assert_header '^Status: 303 See Other$'
assert_header '^Location: https://man\.netbsd\.org/i386/ls$'

# The only field whose value ends the URL, so the only one where a
# trailing CR lands at the end of the header line -- the true
# header-splitting shape, and the case the '$' anchors catch. In
# the other three the CR lands mid-URL.
CGI_BODY=$(printf 'command=ls&arch=DEFAULT&coll=DEFAULT&section=1\r')
run_cgi ''

assert_exit 0
assert_header '^Status: 303 See Other$'
assert_header '^Location: https://man\.netbsd\.org/ls\.1$'

CGI_BODY=$(printf 'section=1&arch=DEFAULT&coll=DEFAULT&command=ls\r')
run_cgi ''

assert_exit 0
assert_header '^Status: 303 See Other$'
assert_header '^Location: https://man\.netbsd\.org/ls\.1$'

# --- POST: names that are not names ----------------------------------

# The POST response is a no-store redirect by construction
# (ADR-0007), so a rejected name degrades to the default here
# instead of 404ing: what matters is that it does not reach the
# Location header.
CGI_BODY='command=ls&section=1&arch=DEFAULT&coll=..'
run_cgi ''

assert_exit 0
assert_header '^Status: 303 See Other$'
assert_header '^Location: https://man\.netbsd\.org/ls\.1$'

CGI_BODY='command=ls&section=ANY&coll=DEFAULT&arch=..'
run_cgi ''

assert_exit 0
assert_header '^Status: 303 See Other$'
assert_header '^Location: https://man\.netbsd\.org/ls$'

# A name that is not one degrades the same way: the 303 goes to the
# query form with no name in it, and the redirect body -- the one
# piece of HTML this arm emits -- quotes a URL without the junk.
CGI_BODY='command=<b>zz&section=1&arch=DEFAULT&coll=DEFAULT'
run_cgi ''

assert_exit 0
assert_header '^Status: 303 See Other$'
assert_header '^Location: https://man\.netbsd\.org/cgi-bin/man-cgi?+1+$'
assert_body_absent '<b>zz'

# The field is the one entry form still carrying an arch prefix
# when the name is judged, and the separator has to survive for
# the 303 to point anywhere.
CGI_BODY='command=i386%2Fls.1&section=ANY&arch=DEFAULT&coll=DEFAULT'
run_cgi ''

assert_exit 0
assert_header '^Status: 303 See Other$'
assert_header '^Location: https://man\.netbsd\.org/i386/ls\.1$'

# What a browser posts for <b>zz. % is outside the set, so the
# encoded form is rejected the same way the raw one is.
CGI_BODY='command=%3Cb%3Ezz&section=1&arch=DEFAULT&coll=DEFAULT'
run_cgi ''

assert_exit 0
assert_header '^Status: 303 See Other$'
assert_header '^Location: https://man\.netbsd\.org/cgi-bin/man-cgi?+1+$'
assert_body_absent '<b>zz'

# The section is judged on this arm too, and a rejected one degrades
# to the form's own default, ANY, rather than being repaired to 1b:
# the same "not a page the client asked for" rule as everywhere
# else, and the same degrade-to-default as the other fields here.
CGI_BODY='command=ls&section=1<b>&arch=DEFAULT&coll=DEFAULT'
run_cgi ''

assert_exit 0
assert_header '^Status: 303 See Other$'
assert_header '^Location: https://man\.netbsd\.org/ls$'
assert_no_header '<b>'
assert_body_absent '<b>'

# A POST inherits whatever the legacy query string parsed before
# the body was read, so a body without a section field leaves the
# query string's section in place; it is judged all the same.
CGI_QUERY='x+<b>'
CGI_BODY='command=ls'
run_cgi ''
CGI_QUERY=

assert_exit 0
assert_header '^Status: 303 See Other$'
assert_header '^Location: https://man\.netbsd\.org/ls$'
assert_no_header '<b>'
assert_body_absent '<b>'

# read -r: without it a trailing backslash splices the next body
# line into the one being parsed, and the splice is then split on
# & like any other body text -- so a second line injects whole
# fields, not just characters. Here the appended coll= overrides
# the one that looked complete, and the redirect goes to
# NetBSD-10.1 instead of A.
CGI_BODY=$(printf 'command=ls&section=1&arch=DEFAULT&coll=A\\\n&coll=NetBSD-10.1')
run_cgi ''

assert_exit 0
assert_header '^Status: 303 See Other$'
assert_header '^Location: https://man\.netbsd\.org/A/ls\.1$'

# A real collection posted without a stray CR still resolves.
CGI_BODY='command=ls&section=1&arch=DEFAULT&coll=NetBSD-10.1'
run_cgi ''

assert_exit 0
assert_header '^Location: https://man\.netbsd\.org/NetBSD-10\.1/ls\.1$'

CGI_METHOD=
CGI_BODY=

test_done
