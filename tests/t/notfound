#!/bin/sh
# @(#)$KimmoSuominen$
#
# The 404 response: status, caching headers, Last-Modified from
# the resolved collection's build file (so 404s revalidate too),
# and the search-engine suggestion body.
#
# 20260809  Kimmo Suominen
#

set -eu

CDPATH=

TESTS_DIR=$(cd "$(dirname "${0}")/.." && pwd)
. "${TESTS_DIR}/lib.sh"

test_init

run_cgi /nosuchcommand.1

assert_exit 0
assert_header '^Status: 404 Not Found$'
assert_header '^Content-Type: text/html; charset=windows-1252$'
assert_header '^Cache-Control: public, max-age=3600$'
assert_header '^X-Accel-Expires: 3600$'
assert_header '^Surrogate-Control: max-age=86400, stale-if-error=86400$'
assert_header "^Last-Modified: ${LM_MDOC}$"
assert_body 'The manual page was not found'
assert_body 'duckduckgo.com'
assert_body_absent 'rel="canonical"'
# The form keeps the name but does not autofocus on a 404 either.
assert_body '^      value="nosuchcommand">$'
assert_body_absent ' autofocus>'

test_done
