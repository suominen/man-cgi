#!/bin/sh
# @(#)$KimmoSuominen$
#
# Characterize headers and body for a plain man-page request
# in the default collection.
#
# 20260809  Kimmo Suominen
#

set -eu

CDPATH=

TESTS_DIR=$(cd "$(dirname "${0}")/.." && pwd)
. "${TESTS_DIR}/lib.sh"

test_init

run_cgi /ls.1

assert_exit 0
assert_no_header '^Status:'
assert_header '^Content-Type: text/html; charset=windows-1252$'
assert_header "^Last-Modified: ${LM_LS1}\$"
assert_header '^Cache-Control: public, max-age=3600$'
assert_header '^X-Accel-Expires: 3600$'
assert_header '^Surrogate-Control: max-age=86400, stale-while-revalidate=3600, stale-if-error=604800$'
assert_header '^Expires: '
assert_body '<pre class="manpage">'
assert_body 'rel="canonical" href="https://man.netbsd.org/ls.1"'
assert_body 'Powered by man-cgi'

# The sed HTMLizer: section anchors, bold/italic conversion from
# nroff overstrike, and SEE-ALSO cross-linking.
assert_body 'id="NAME"'
assert_body '<b>ls</b>'
assert_body '<i>file</i>'
assert_body 'href="/cat.1"'

# Literal <, >, and & in the man output are HTML-escaped (the
# HTMLizer stashes < and > in placeholders while it inserts its
# own tags, then entifies them at the end).
assert_body '&lt;file&gt;'
assert_body 'a&lt;b'
assert_body 'a&gt;b'
assert_body 'x&amp;y'
assert_body_absent '<file>'
# No placeholder byte may leak anywhere in the page.
assert_body_absent "$(printf '[\001\002]')"

# The section select preselects the page's own section.
assert_body '<option value="1" selected>1 - General Commands</option>'

# A man page must not autofocus the command field: that would steal
# the scroll keys from the reader. The / shortcut focuses it instead,
# and the field is pre-filled with the page's own name.
assert_body 'value="ls" title="Press / to focus">'
assert_body_absent 'autofocus'
assert_body "addEventListener('keydown'"

test_done
